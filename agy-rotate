#!/usr/bin/env python3
"""Antigravity(agy) 账号池 CLI —— 收编 / 看额度 / 换号 / 选号。

    agy-rotate login [label]   加一个号：保住当前的 → 起 agy 让你登录新号 → 回来自动收编
    agy-rotate login --current 只收编**当前登录**的号，不起 agy（第一次建池用它）
    agy-rotate list            列出池 + 上次读到的额度
    agy-rotate quota [--json]  刷新全池额度（零消耗，不需要 agy 在跑）
    agy-rotate switch <label>  把某个号装回 agy 的登录态
    agy-rotate pick [--why]    按额度挑一个号（自动切用；只打印 label，不动凭证）
    agy-rotate auto            = pick + 必要时 switch（`bin/agy` 启动前调它）
    agy-rotate rename <旧> <新>
    agy-rotate remove <label>

## 加号为什么不自己实现 OAuth

★ agy **没有** login/logout 子命令（`agy --help` 实测），登录只能在 TUI 里走。
  我们不"代替"用户登录，只把他前后那两步接上：**先把当前号存进池**（`/logout` 会就地
  清掉唯一那份登录态，不先存就丢了），再在他登完之后自动收编。
★ 也因此不需要把 client_secret 常驻在代码里 —— 而这个仓库是公开的。

## ★★ 换号只对**下一次启动**生效

  agy 在启动时读 `antigravity-oauth-token`，之后不再读。所以：
  - 自动切发生在 `bin/agy` **exec 真身之前**，那是唯一能保证本次会话用对号的时刻；
  - 对**已经开着**的 agy 会话，换文件不影响它 —— 这是设计事实，文案必须这么写，
    不能让用户以为点一下就切走了正在跑的那个。
"""
import json
import os
import subprocess
import sys
import time

#: 探针的硬上限。实测一次约 30s（agy 起进程 ~10s + 生成 ~8s），留三倍余量。
#: ★ 必须有上界：没有的话一个卡住的 agy 会把 GUI 的按钮永远钉在「探测中…」。
PROBE_TIMEOUT = int(os.environ.get("AGY_PROBE_TIMEOUT", "120"))
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agy import pool as P                                    # noqa: E402


def _fmt_pct(v):
    return "—" if v is None else "%.1f%%" % (float(v) * 100)


def _fmt_reset(s):
    """`2026-09-13T10:31:36Z` → 本地 `09-13 18:31`。★ 显示一律转本地：
    用户看的是自己的钟，而服务端给的是 UTC —— 混着看会差 8 小时。"""
    if not s:
        return "—"
    try:
        import datetime
        d = datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone()
        return d.strftime("%m-%d %H:%M")
    except Exception:                                        # noqa: BLE001
        return s


def _accounts(pool):
    return pool.setdefault("accounts", {})


def _mark_live(pool):
    """把「当值号」记进池 -> sub。

    ★ 池文件本身认不出谁在当值 —— 那个事实只写在 agy 的登录态文件里。
      所以每条**知道**它的命令都顺手记一次，前端才不用自己去解 JWT。
    ★ 它可能过时（用户在 agy 里 `/logout` 换了号而没跑我们的命令）。
      所以字段名是 `live_seen` 不是 `live`：**上次我们看到的**，下次 `quota` 会纠正。
    """
    sub = (P.claims(P.read_live()) or {}).get("sub")
    pool["live_seen"] = sub
    return sub


def _by_label(pool, key):
    """label 或 sub 前缀都认。★ 与 codex 池同一条教训：**label 是可改的显示名**，
    所以内部一律存 `sub`，只在查找时接受 label。"""
    accs = _accounts(pool)
    if key in accs:
        return key
    hit = [s for s, a in accs.items() if a.get("label") == key]
    if len(hit) == 1:
        return hit[0]
    if len(hit) > 1:
        sys.exit("★ 有 %d 个号都叫 '%s' —— 先 rename 一个再来" % (len(hit), key))
    pre = [s for s in accs if s.startswith(key)]
    return pre[0] if len(pre) == 1 else None


def _adopt(label=None, quiet=False):
    """把**当前登录**的号收进池 -> (sub, 是否新号)。收不了就退出并说清楚为什么。"""
    live = P.read_live()
    if not live:
        sys.exit("读不到当前登录态 —— 先在 agy 里登录一个号\n"
                 "  （主存储是 macOS 钥匙串 %s/%s，兜底文件 %s）"
                 % (P.KEYRING_SVC, P.KEYRING_ACCT, P.LIVE))
    cl = P.claims(live)
    sub, email = cl.get("sub"), cl.get("email")
    if not sub:
        sys.exit("当前凭证里没有 id_token.sub —— 认不出这是哪个号，拒绝收编")
    pool = P.load()
    accs = _accounts(pool)
    fresh = sub not in accs
    label = label or accs.get(sub, {}).get("label") or (email or sub).split("@")[0]
    P.write_cred(sub, live)
    accs[sub] = {**accs.get(sub, {}), "label": label, "email": email,
                 "adopted_at": accs.get(sub, {}).get("adopted_at") or int(time.time()),
                 "updated_at": int(time.time())}
    with P._lock(P.POOL):
        P.save(pool)
    if not quiet:
        print("%s [%s] %s" % ("已收编" if fresh else "已更新", label, email or sub[:12]))
    return sub, fresh


def cmd_login(args):
    """加一个号：先保住当前的，再起 agy 让你登录新号，回来自动收编。

    ★★★ **必须先把当前号收进池再让用户去 `/logout`。** agy 的登录态只有一份，
      `/logout` 会就地把它清掉 —— 没有先备份的话，那个号就此丢了，用户要重新走一遍
      浏览器 OAuth 才能拿回来。这一步不是"顺手做的"，它是这条命令存在的理由之一。

    ★ agy **没有** login/logout 子命令（`agy --help` 实测），登录只能在 TUI 里走。
      所以我们不"代替"用户登录，只是把他前后那两步（保住旧的、收编新的）接上。

    `--current` 只收编当前登录的号，不起 agy —— 第一次建池用它。
    """
    only = "--current" in args
    label = next((a for a in args if not a.startswith("-")), None)
    before, _ = _adopt(label if only else None)
    if only:
        _hint_next(P.load())
        return

    pool = P.load()
    print("\n接下来会启动 agy。在里面：")
    print("  1. 输入 `/logout`")
    print("  2. 按提示在浏览器里登录**另一个** Google 账号")
    print("  3. 退出 agy（Ctrl-D / `/quit`）——回来我会自动把新号收进池")
    print("\n★ 刚才那个号（%s）已经存进池里了，随时可以 `agy-rotate switch` 切回去。"
          % _accounts(pool).get(before, {}).get("label"))
    try:
        input("准备好就按回车（Ctrl-C 放弃）… ")
    except (EOFError, KeyboardInterrupt):
        print("\n已放弃 —— 池里那份没动。")
        return

    real = Path(os.environ.get("AGY_REAL", str(Path.home() / ".local" / "bin" / "agy")))
    if not real.exists():
        sys.exit("找不到 agy（%s）" % real)
    # ★ 用 subprocess 而不是 execv：execv 之后本进程就没了，**回不来收编**。
    #   交互态要保住 TTY，所以不接管任何一条流。
    subprocess.run([str(real)], check=False)

    after_cred = P.read_live()
    after = (P.claims(after_cred) or {}).get("sub")
    if not after:
        # ★ 这条曾是**假阴性**（2026-09-13 用户实报）：登录其实成功了，
        #   只是我们读的是文件、而 agy 把新凭证写进了钥匙串。`read_live()` 现在
        #   钥匙串优先，所以走到这里才是真的没读到。措辞也跟着改成两种可能。
        print("\n✗ 回来之后读不到登录态 —— 登录没完成，或者钥匙串读不出来。"
              "\n  池里那份没丢：`agy-rotate switch %s` 装回去。"
              % _accounts(pool).get(before, {}).get("label"))
        return
    if after == before:
        # ★ 三态里最容易被讲错的那个：**没换号** ≠ 失败，也 ≠ 成功加号。
        print("\n还是原来那个号（没有 `/logout`，或者又登了同一个账号）—— 池没有变化。")
        return
    sub, fresh = _adopt(label)
    print("  ★ 新号已成为当前登录态。" if fresh else "  ★ 这个号本来就在池里，已更新凭证。")
    _hint_next(P.load())


def _hint_next(pool):
    n = len(_accounts(pool))
    if n < 2:
        print("  ★ 池里只有一个号，轮换还没有意义 —— `agy-rotate login` 再加一个。")
    else:
        print("  池里现在 %d 个号。`agy-rotate quota` 看额度，`agy --as <label>` 指定号跑。" % n)


def _refresh_one(sub, acc, pool):
    """→ (cred, err)。必要时刷新并**写回池里的凭证**（不碰 agy 的登录态）。"""
    cred = P.read_cred(sub)
    if not cred:
        return None, "凭证文件不在（auth/agy/%s.json）" % sub
    if not P.expired(cred):
        return cred, ""
    fresh, err = P.refresh(cred, pool)
    if err:
        return None, err
    P.write_cred(sub, fresh)
    return fresh, ""


def cmd_quota(args):
    want_json = "--json" in args
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        sys.exit("池是空的 —— 先 `agy-rotate adopt`")
    live_sub = _mark_live(pool)
    out = []
    for sub, a in accs.items():
        cred, err = _refresh_one(sub, a, pool)
        if err:
            a["quota_err"] = err
            out.append({"sub": sub, "label": a.get("label"), "err": err})
            continue
        q, err = P.fetch_quota(cred["token"]["access_token"])
        # ★★ 失败态一律**不写数字**：`0` 是"用光了"的合法值，一旦某条失败路径悄悄写出 0，
        #    UI 会画一条正常的红条，而用户没有第二个办法分辨。同 grok/agy 额度那条降级契约。
        a["quota"] = q if not err else None
        a["quota_err"] = err or None
        a["quota_at"] = int(time.time())
        out.append({"sub": sub, "label": a.get("label"), "live": sub == live_sub,
                    "quota": q, "err": err or None})
    with P._lock(P.POOL):
        P.save(pool)
    if want_json:
        print(json.dumps({"accounts": out, "at": int(time.time())}, ensure_ascii=False))
        return
    for r in out:
        tag = " ←当前" if r.get("live") else ""
        if r.get("err"):
            print("  [%-10s] ✗ %s%s" % (r["label"], r["err"], tag))
            continue
        parts = ["%s %s(重置 %s)" % (g, _fmt_pct(v["remaining"]), _fmt_reset(v["reset"]))
                 for g, v in (r["quota"] or {}).items()]
        print("  [%-10s] %s%s" % (r["label"], " · ".join(parts) or "无额度信息", tag))


def cmd_list(args):
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        print("池是空的 —— `agy-rotate adopt` 收编当前登录的号")
        return
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    for sub, a in accs.items():
        q = a.get("quota") or {}
        g = (q.get("gemini") or {})
        print("  %-10s %-28s gemini %s  重置 %s%s%s" % (
            a.get("label"), (a.get("email") or sub)[:28],
            _fmt_pct(g.get("remaining")), _fmt_reset(g.get("reset")),
            "  ←当前" if sub == live_sub else "",
            "  ✗" + a["quota_err"] if a.get("quota_err") else ""))


def _score(a):
    """选号用的剩余比例。★ 只看 `gemini` 组 —— 它是 agy 的主力池（实测 20/27 个模型），
    而 claude 组那 3 个模型用不到时永远是 1.0，掺进来会让排序失去分辨力。
    取不到额度的号排在**最后**：不是「它满额」，是「我们不知道」。"""
    q = (a.get("quota") or {}).get("gemini") or {}
    r = q.get("remaining")
    return float(r) if isinstance(r, (int, float)) else -1.0


def cmd_pick(args):
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        sys.exit("池是空的")
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    ranked = sorted(accs.items(), key=lambda kv: -_score(kv[1]))
    best_sub, best = ranked[0]
    cur = accs.get(live_sub)
    # ★ 当前号还够用就**不换** —— 无谓换号会打断 agy 的 prompt 缓存（上游那些项目
    #   把这叫 sticky 策略，默认就是它）。
    if cur is not None and _score(cur) >= P.LOW_WATER:
        best_sub, best = live_sub, cur
    if "--why" in args:
        print("阈值 %.0f%% · 当前 [%s] %s → 选 [%s] %s" % (
            P.LOW_WATER * 100, (cur or {}).get("label", "—"), _fmt_pct(_score(cur) if cur else None),
            best.get("label"), _fmt_pct(_score(best))))
    print(best.get("label") or best_sub)


def cmd_switch(args):
    if not args:
        sys.exit("usage: agy-rotate switch <label>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    cred, err = _refresh_one(sub, _accounts(pool)[sub], pool)
    if err:
        sys.exit("✗ %s" % err)
    live_sub = _mark_live(pool)
    if live_sub == sub:
        print("[%s] 已经是当前号，没动" % _accounts(pool)[sub].get("label"))
        return
    where = P.install_live(cred)
    _mark_live(pool)
    if "--for-this-run" not in args:
        # ★★★ 记下**用户显式要的那个号**。`live_seen` 回答"钥匙串里现在是谁"，
        #   而这个回答"用户要的是谁" —— 两件事，合并就没法发现被劫持。
        #   `auto` 据此在钥匙串被别的 agy 进程写回之后**把用户的选择装回去**，
        #   而不是看到"当前号额度还够"就 return（那等于静默撤销用户的操作）。
        #   `bin/agy` 的 `--as` 传 `--for-this-run`：那是一次性指定，不是长期偏好。
        pool["live_wanted"] = sub
    with P._lock(P.POOL):
        P.save(pool)
    print("已切到 [%s] —— ★ 只对**下一次启动的** agy 生效，已经开着的会话不受影响"
          % _accounts(pool)[sub].get("label"))
    if where != "keyring":
        # ★★ 不许静默。2026-09-13 之前这条路**一直**只写文件，而 agy 只读钥匙串 ——
        #   换号是空操作，命令却照常打印「已切到」。宁可多说一句，也不能再让
        #   「我们写成功了」冒充「agy 真的换了号」。
        print("  ⚠️ 没能写进钥匙串（agy 的主存储），只写了兜底文件 —— "
              "agy 很可能仍在用原来那个号。\n"
              "     钥匙串被锁住时会这样：解锁登录钥匙串后重试一次。")


def cmd_auto(args):
    """选号 + 必要时换凭证。`bin/agy` 在 exec 真身之前调它。

    ★ 整体 fail-open：选不出来/刷不动，就让 agy 用**当前**登录态照常跑。
      轮换是增益，不是前置条件 —— 把它做成前置条件就会出现「CodexBar 坏了导致 agy 用不了」。
    """
    try:
        pool = P.load()
        # ★★★ **开关必须在这里真的被读到。** 只把状态存进池、而 `auto` 照切，
        #   就是本仓那条「写入侧标志会撒谎」——界面说关着、wrapper 照样换号，
        #   而用户完全看不出来。闸 `tests/test_agy_actions.py` 打在这两行上。
        if pool.get("auto_off"):
            return
        accs = {s: a for s, a in _accounts(pool).items() if not a.get("rotate_off")}
        if len(accs) < 2:
            return
        live_sub = (P.claims(P.read_live()) or {}).get("sub")
        # ★★★ **先兑现用户显式要的那个号，再谈"够不够用"。**（2026-09-13 三方评审共同指出）
        #   钥匙串是**一个槽**，被多个常驻 agy 进程并发写：用户 switch 到 B 之后，
        #   一个身份为 A 的旧进程会在自己 token 到期时把 A 写回去。此时下面那条
        #   「当前号额度还够就 return」会看到 A、且 A 健康 ⇒ **静默放弃用户的选择**，
        #   新会话仍是 A。用户看到的是"我明明切过了"。这比显示错更严重：
        #   它让工具**撤销**了一个明确的指令，而且不出声。
        want = pool.get("live_wanted")
        # ★ 被摘出轮换池的号不该被"恢复"回去 —— 用户显式关掉了它。
        if want and want in accs and live_sub != want:
            cred, err = _refresh_one(want, accs[want], pool)
            if not err:
                where = P.install_live(cred)
                _mark_live(pool)
                with P._lock(P.POOL):
                    P.save(pool)
                print("[codexbar] agy 恢复成你选的 [%s]（钥匙串被别的 agy 进程写回过）%s"
                      % (accs[want].get("label"),
                         "" if where == "keyring" else " ⚠️ 只写了兜底文件，可能未生效"),
                      file=sys.stderr)
                return
        cur = accs.get(live_sub)
        if cur is not None and _score(cur) >= P.LOW_WATER:
            return
        ranked = sorted(accs.items(), key=lambda kv: -_score(kv[1]))
        sub, a = ranked[0]
        if sub == live_sub or _score(a) < P.LOW_WATER:
            return                                    # 全池都低 —— 换了也没用，别白折腾
        cred, err = _refresh_one(sub, a, pool)
        if err:
            return
        where = P.install_live(cred)
        _mark_live(pool)
        with P._lock(P.POOL):
            P.save(pool)
        # ★ 落点写进这一行：只写了文件的话这次自动切**没有生效**，
        #   而 agy 照跑、用户看到的一切都正常 —— 那正是要避免的那种"成功"。
        print("[codexbar] agy 自动切到 [%s]（剩余 %s）%s"
              % (a.get("label"), _fmt_pct(_score(a)),
                 "" if where == "keyring" else " ⚠️ 只写了兜底文件，可能未生效"),
              file=sys.stderr)
    except Exception:                                 # noqa: BLE001
        return


def cmd_rename(args):
    if len(args) < 2:
        sys.exit("usage: agy-rotate rename <old> <new>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    new = args[1].strip()
    if not new or any(c.isspace() for c in new):
        sys.exit("新名字不能为空、不能含空格（它要当命令行参数用）")
    accs = _accounts(pool)
    if any(s != sub and a.get("label") == new for s, a in accs.items()):
        sys.exit("'%s' 已经被别的号占了" % new)
    accs[sub]["label"] = new
    with P._lock(P.POOL):
        P.save(pool)
    print("renamed → %s" % new)


def cmd_remove(args):
    if not args:
        sys.exit("usage: agy-rotate remove <label>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    lbl = _accounts(pool)[sub].get("label")
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    if sub == live_sub:
        sys.exit("[%s] 正是当前登录的号 —— 先 switch 到别的号再移除，"
                 "否则你会既不在池里、也没有别的登录态可回。" % lbl)
    del _accounts(pool)[sub]
    with P._lock(P.POOL):
        P.save(pool)
    try:
        P.cred_path(sub).unlink()
    except OSError:
        pass
    print("已移除 [%s]" % lbl)


def cmd_health(args):
    """**零消耗**地问 Google：池里每个号的凭证还有效吗。

    ★★★ 这是 codex `health` 的 agy 版，但**机制完全不同**，别照搬：
      codex 是问 OpenAI「这个 token 被作废了吗」；agy 这边是
      **拿 refresh_token 换一次 access_token，再打一次 `fetchAvailableModels`**。
      两步都成功才算这个号真的还能用 —— 只刷不打，换来的 token 可能对 API 没权限。

    ★★ **刷新是安全的，这一条必须实测过才敢写。** Google 默认**不轮换** refresh_token
      （响应里没有那个字段，2026-09-13 实测），所以我们刷不会作废 agy 自己手里那份。
      ⚠️ 与本仓对 grok 的铁律**正好相反**（grok 单次有效、绝不刷）——
      两家行为是反的，照搬任何一边都会杀号。

    零消耗：`fetchAvailableModels` 不产生 token 用量，只回额度与模型清单。
    """
    want_json = "--json" in args
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        sys.exit("池是空的 —— 先 `agy-rotate login --current`")
    live = _mark_live(pool)
    rows = []
    for sub, a in accs.items():
        cred = P.read_cred(sub)
        if not cred:
            rows.append((sub, a, "no_cred", "池里没有这个号的凭证文件"))
            continue
        cred, err = P.refresh(cred, pool)
        if err:
            # ★ `invalid_grant` = 凭证被作废（掉登录），与「网络不通」必须分开：
            #   前者要重新走浏览器 OAuth，后者等一会儿再来。合并成一句话，
            #   用户就会对着一个网络抖动去重新登录。
            kind = "revoked" if "invalid_grant" in err else "error"
            rows.append((sub, a, kind, err))
            continue
        P.write_cred(sub, cred)
        q, qerr = P.fetch_quota(cred["token"]["access_token"])
        rows.append((sub, a, "ok" if not qerr else "api_error", qerr or ""))
        if not qerr:
            a["quota"] = {k: {"remaining": v["remaining"], "reset": v["reset"]} for k, v in q.items()}
            a["quota_at"] = int(time.time())
    a_now = int(time.time())
    for sub, a, kind, _d in rows:
        # ★ 独立兄弟键，与 `quota` 分开：`quota` 会被别的路径整体替换，
        #   健康结论跟着它走就会在下一次刷新后凭空消失（同 codex 的 `last_probe`）。
        a["last_health"] = {"at": a_now, "ok": kind == "ok", "kind": kind}
    with P._lock(P.POOL):
        P.save(pool)
    if want_json:
        print(json.dumps([{"sub": s, "label": a.get("label"), "kind": k, "detail": d}
                          for s, a, k, d in rows], ensure_ascii=False))
        return
    TXT = {"ok": "✓ 还能用", "revoked": "✗ 掉登录（要重新走浏览器 OAuth）",
           "no_cred": "✗ 池里没有凭证文件", "api_error": "⚠️ 刷新成功但 API 打不通",
           "error": "⚠️ 刷新失败"}
    for sub, a, kind, detail in rows:
        print("  [%s]%s %s%s" % (a.get("label"), " ←当前" if sub == live else "",
                                 TXT.get(kind, kind), (" — " + detail[:80]) if detail else ""))
    bad = [a.get("label") for _s, a, k, _d in rows if k != "ok"]
    print("  %d/%d 个还能用%s" % (len(rows) - len(bad), len(rows),
                                  ("；有问题的：" + "、".join(bad)) if bad else ""))


#: 探针问的话与判据。★ 与 codex 探针同一条纪律：**判据是「模型真吐出字」**，
#: 不是退出码 0 —— 200/exit 0 只说明请求被受理，流中途断掉照样 0。
PROBE_ASK = "Reply with exactly: ok"


def _probe_one(label):
    """对**当前登录**的号跑一次真实生成 -> (ok, 说明, usage dict|None)。

    ★★★ 为什么是"起一次 agy"而不是自己拼 HTTP：
      2026-09-13 实测，直接打 `v1internal:streamGenerateContent` 恒 **429
      RESOURCE_EXHAUSTED**，即使该号额度满格、模型 id 取自它自己的
      `fetchAvailableModels`、也带上了 `loadCodeAssist` 回的 `aicode-consumers`。
      ⚠️ **那个 429 极具误导性**：它长得和「额度用光了」一模一样，而真因是我们
      没有复刻 agy 的完整客户端身份。用它做探针会把"我们拼错了"报成"你的号没额度了"。
      所以探针走 **agy 自己**（`agy -p … --output-format json`）——
      它顺带给出**精确到 token 的用量**，比 codex 那边只能拿到整数百分比还清楚。

    ★ 代价：一次约 30s、约 15k token（实测）。这是**花 agy 自己额度**的动作。
    """
    real = Path(os.environ.get("AGY_REAL", str(Path.home() / ".local" / "bin" / "agy")))
    if not real.exists():
        return False, "找不到 agy（%s）" % real, None
    try:
        r = subprocess.run([str(real), "-p", PROBE_ASK, "--output-format", "json"],
                           capture_output=True, text=True, timeout=PROBE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return False, "超时（%ds）" % PROBE_TIMEOUT, None
    if r.returncode != 0:
        return False, "agy 退出码 %d：%s" % (r.returncode, (r.stderr or "")[-160:]), None
    try:
        d = json.loads((r.stdout or "").strip())
    except ValueError:
        return False, "输出不是 JSON（前 120 字：%s）" % (r.stdout or "")[:120], None
    ans = (d.get("response") or "").strip()
    if d.get("status") != "SUCCESS" or not ans:
        # ★ 空回答判失败 —— 「受理了」不等于「干成了」。
        return False, "没吐出字（status=%s）" % d.get("status"), d.get("usage")
    # 答非所问只标 ⚠️ 不算失败：模型换个措辞不代表账号有问题（同 codex 探针）。
    note = "答「%s」" % ans[:24] + ("" if ans.lower().startswith("ok") else " ⚠️ 答非所问")
    return True, note, d.get("usage")


def cmd_probe(args):
    """计费探针。★★★ **这是 Gemini 档唯一会花钱的动作，花的是 agy 自己的额度。**

    回答 `health` 回答不了的那个问题：**这个号真的还能干活吗** ——
    凭证有效但订阅到期 / 模型权限被撤 / 被限流，只有真发一次请求才测得出来。

    ★★ **非当值号要先切过去**：agy 只在进程启动时读凭证，没有"指定号发一次请求"
      这种东西（这正是 agy 与 codex 的结构性差异）。所以这里是
      **切过去 → 探 → 切回来**，而且切回来放在 `finally` 里 ——
      中途异常也不能把用户留在别的号上。
    """
    want_json = "--json" in args
    pool = P.load()
    accs = _accounts(pool)
    live = _mark_live(pool)
    names = [a for a in args if not a.startswith("-")]
    if "--all" in args:
        subs = list(accs)
    elif names:
        subs = [s for s in (_by_label(pool, n) for n in names) if s]
    else:
        subs = [live] if live in accs else []
    if not subs:
        sys.exit("没指定要探哪个号 —— `agy-rotate probe <label>` 或 `--all`")

    out = []
    try:
        for sub in subs:
            a = accs[sub]
            if sub != (P.claims(P.read_live()) or {}).get("sub"):
                cred, err = _refresh_one(sub, a, pool)
                if err:
                    out.append((a, False, "切不过去：%s" % err, None))
                    continue
                if P.install_live(cred) != "keyring":
                    out.append((a, False, "只写了兜底文件，agy 多半还在用别的号", None))
                    continue
            ok, note, usage = _probe_one(a.get("label"))
            out.append((a, ok, note, usage))
            a["last_probe"] = {"at": int(time.time()), "ok": ok, "note": note,
                               "usage": usage}
    finally:
        # ★★ 把用户放回他原来的号。放在 finally 里：中途炸了也不能把他留在别处。
        if live and live in accs and (P.claims(P.read_live()) or {}).get("sub") != live:
            cred, err = _refresh_one(live, accs[live], pool)
            if not err:
                P.install_live(cred)
        _mark_live(pool)
        with P._lock(P.POOL):
            P.save(pool)

    if want_json:
        print(json.dumps([{"label": a.get("label"), "ok": ok, "note": n, "usage": u}
                          for a, ok, n, u in out], ensure_ascii=False))
        return
    for a, ok, note, usage in out:
        tok = ("（%s token）" % format(usage.get("total_tokens", 0), ",")) if usage else ""
        print("  [%s] %s %s%s" % (a.get("label"), "✓" if ok else "✗", note, tok))


def cmd_rotate(args):
    """按号开关自动轮换。`agy-rotate rotate <label> --on|--off`

    ★★ 真源是池里的 `rotate_off`，**存反向命名**：缺省必须等于「参与轮换」——
      存量号与 `login` 收编的新号都没有这个键，正向命名要写迁移，
      漏迁移的号会**静默退出轮换池**（症状：自动切号只在那两三个号里转，零报错）。
      恢复时**删键**不是写 `False`，否则"缺省"有两种表示。
      与 codex 的 `rotate_off` 一字不差的同一条设计。
    """
    if len(args) < 2 or args[1] not in ("--on", "--off"):
        sys.exit("usage: agy-rotate rotate <label> --on|--off")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    accs = _accounts(pool)
    on = args[1] == "--on"
    if not on:
        # ★ 拒绝关掉最后一个：全关 = 自动切号无号可挑。
        live_n = sum(1 for s, a in accs.items() if not a.get("rotate_off") and s != sub)
        if live_n == 0:
            sys.exit("✗ 这是最后一个还参与轮换的号 —— 全关掉的话自动切号就没号可挑了")
    if on:
        accs[sub].pop("rotate_off", None)
    else:
        accs[sub]["rotate_off"] = True
    with P._lock(P.POOL):
        P.save(pool)
    print("[%s] 自动轮换已%s" % (accs[sub].get("label"), "开启" if on else "关闭"))


def cmd_autoswitch(args):
    """全局自动切号开关。`agy-rotate auto-switch [--on|--off]`

    ★★★ **这条能做，我此前说"做不了"是错的。** 当时的理由是「自动选号发生在
      `bin/agy` 拉起进程之前」—— 那句话本身没错，但结论错了：wrapper 调的是
      `agy-rotate auto`，而它**读池**。所以一个持久化到池里的开关完全控制得住它。
      真源放池里（不放 localStorage）的理由与 codex 的 `dawn_probe` 一致：
      wrapper 在 app 没开时也要读它，两个真源迟早分叉成
      「界面说关着、wrapper 照切」。
    """
    pool = P.load()
    if "--on" in args or "--off" in args:
        off = "--off" in args
        if off:
            pool["auto_off"] = True
        else:
            pool.pop("auto_off", None)      # 删键，不写 False —— 缺省只能有一种表示
        with P._lock(P.POOL):
            P.save(pool)
    on = not pool.get("auto_off")
    if "--json" in args:
        print(json.dumps({"enabled": on}))
    else:
        print("自动切号：%s" % ("开" if on else "关"))


def cmd_live(args):
    """**现在**到底是谁登录着 —— 只读钥匙串，不联网、不改任何状态。

    ★★★ 存在理由：`live_seen` 是**我们上次写进去时看到的值**，而钥匙串是一个
      **被多个长期存活的 agy 进程并发写**的单槽。实测 2026-09-13：
      17:58 我们装进 B，18:23:17 一个身份为 A 的常驻 agy 在它自己的 access token
      到期（18:23:16）时刷新并把整份凭证写回钥匙串 —— B 被冲掉，而 `live_seen`
      毫不知情，界面继续理直气壮地显示 B。用户看到的就是「界面说 B、agy 里是 A」。

    所以 UI 的「当前」徽章必须由**这条现读**驱动，`live_seen` 降级成诊断字段。
    两个事实都给出来，分歧就看得见，而不是被抹平成一个好看的谎。
    """
    pool = P.load()
    cl = P.claims(P.read_live()) or {}
    sub = cl.get("sub")
    seen = pool.get("live_seen")
    if "--json" in args:
        print(json.dumps({"sub": sub, "email": cl.get("email"),
                          "live_seen": seen, "drifted": bool(sub and seen and sub != seen)},
                         ensure_ascii=False))
        return
    label = _accounts(pool).get(sub, {}).get("label") if sub else None
    print("当前登录：%s" % (label or cl.get("email") or sub or "（读不到）"))
    if sub and seen and sub != seen:
        # ★ 不许静默吞掉分歧：它是"有别的 agy 进程把槽抢回去了"的唯一可见证据。
        print("  ⚠️ 与我们上次装进去的 [%s] 不一致 —— 多半是某个**仍在跑**的 agy "
              "在它自己 token 到期时把凭证写回了钥匙串。"
              % (_accounts(pool).get(seen, {}).get("label") or seen[:8]))


CMDS = {"login": cmd_login, "list": cmd_list, "quota": cmd_quota, "switch": cmd_switch,
        "pick": cmd_pick, "auto": cmd_auto, "rename": cmd_rename, "remove": cmd_remove,
        "live": cmd_live, "health": cmd_health, "probe": cmd_probe,
        "rotate": cmd_rotate, "auto-switch": cmd_autoswitch}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    fn = CMDS.get(argv[0])
    if not fn:
        sys.exit("未知命令 '%s' —— 可用: %s" % (argv[0], " ".join(sorted(CMDS))))
    fn(argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
