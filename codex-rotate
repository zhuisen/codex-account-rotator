            if p and not _rollout_is_proxy(p):
                s["last_plain_ts"] = p.stat().st_mtime  # newest plain-codex activity — the title's
            _save_state(s)                              # cxp-vs-plain arbitration signal
    print(json.dumps(q, ensure_ascii=False) if q else "null")


USAGE_PATH = "/backend-api/codex/usage"


def _win_from_usage(w):
    """Map one usage-API window {used_percent, limit_window_seconds, reset_at} → our snapshot shape."""
    if not isinstance(w, dict) or w.get("used_percent") is None:
        return None
    secs = w.get("limit_window_seconds")
    reset = w.get("reset_at")
    if reset is None and w.get("reset_after_seconds") is not None:
        reset = time.time() + w["reset_after_seconds"]
    return {
        "used_percent": float(w["used_percent"]),
        "window_minutes": (float(secs) / 60.0) if secs else None,
        "resets_at": float(reset) if reset is not None else None,
    }


def _probe_quota(aid, slot, is_active):
    """Read live quota from Codex's OFFICIAL account-usage endpoint — GET, so it costs ZERO quota.

    ★ Replaces the old probe, which sent a real `POST /backend-api/codex/responses` just to read the
    x-codex-* response headers: that was a billed completion, so every refresh burned real quota (a big
    deal since Codex retired the 5h window for a small weekly one). The Codex CLI binary itself exposes
    GetAccountRateLimitsResponse via `GET /backend-api/codex/usage`; verified 2026-07-30 to return
    {rate_limit:{primary_window:{used_percent,limit_window_seconds,reset_at},secondary_window},plan_type}
    for BOTH active and non-active accounts, and 401 for revoked ones (doubles as a health check).

    Read-only on the token (never OAuth-refreshes — the active account's live token stays codex-owned);
    active reads live auth.json, inactive reads its slot file. Returns (quota_dict|None, msg)."""
    authpath = LIVE if is_active else (AUTH_DIR / slot["file"])
    try:
        auth = _load_json(authpath)
        tok = (auth.get("tokens") or {})
    except (OSError, ValueError) as e:
        return None, f"read err: {e}"
    # ★ Invariant: the token we probe must BELONG to the account we attribute the result to. Violating
    # it now costs more than a wrong number — a 401 marks that account dead and a 200 revives it, i.e.
    # it changes pool membership. Both branches are checked:
    #   • active   — refresh-all walks the pool over seconds, and a switch (CodexBar / cxp / ensure-live)
    #     landing mid-loop leaves LIVE holding a DIFFERENT account's token.
    #   • inactive — auth/<aid>.json should always hold account <aid>, so a mismatch means the slot file
    #     is corrupt or was hand-edited; attributing it is worse than reporting nothing.
    if _account_id(auth) != aid:
        return None, ("live account switched mid-probe" if is_active
                      else "slot file/account mismatch — not attributing")
    if _access_exp(tok) - time.time() < 60:
        return None, "token expired (\\codex login / wait keepalive)"
    # Cloudflare rate-limits this endpoint per client, and it answers 403/429 (never 401) when it does —
    # observed all four accounts returning 403 in one burst, then 200 on an immediate retry. Those codes
    # are transient and MUST NOT be mistaken for an account problem, so back off once and retry.
    status, raw = None, b""
    for attempt in range(2):
        if attempt:
            time.sleep(2.5)
        conn = http.client.HTTPSConnection("chatgpt.com", 443, context=ssl.create_default_context(), timeout=30)
        try:
            conn.request("GET", USAGE_PATH, headers={
                "Authorization": f"Bearer {tok.get('access_token', '')}",
                "chatgpt-account-id": tok.get("account_id"),
                "originator": "codex_cli_rs", "User-Agent": "codex_cli_rs/0.144.6",
                "Accept": "application/json"})
            r = conn.getresponse()
            status = r.status
            raw = r.read()
        except Exception as e:
            return None, f"req err: {e}"
        finally:
            conn.close()
        if status not in (403, 429):
            break

    # ★ 401 here is the server saying the token is REVOKED — the local JWT exp was already checked above,
    # so this is exactly the "valid-looking but server-side dead" case that `health` cannot detect (B21).
    # Until now only proxy.py ever set auth_dead, so an account that died while IDLE (never routed through
    # the proxy) kept showing its last stale snapshot — plus7 sat at a 26h-old "0% remaining", which reads
    # as "quota exhausted" when it was really "token revoked". The usage endpoint gives this signal for
    # FREE on every account, so wire it here. auth_dead_fp = tail of the REJECTED token, preserving B16's
    # revival gate (autosync only clears the flag when a genuinely DIFFERENT token appears).
    if status == 401:
        fp = (tok.get("access_token") or "")[-16:] or None
        def _dead(st, a=aid, f=fp):
            sl = st.get("slots", {}).get(a)
            if sl is not None:
                already = sl.get("auth_dead")
                sl["auth_dead"] = True
                if not already:                       # keep the ORIGINAL death time — the UI treats a
                    sl["auth_dead_at"] = time.time()  # changed timestamp as a NEW death event
                sl["auth_dead_src"] = "probe"         # see _revive: a detector may only retract its own
                if f:
                    sl["auth_dead_fp"] = f
        _mutate_state(_dead)
        return None, "HTTP 401 (token revoked — \\codex login)"
    if status in (403, 429):
        return None, f"HTTP {status} (限流,稍后自动重试)"
    if status != 200:
        return None, f"HTTP {status}"
    try:
        d = json.loads(raw)
    except ValueError as e:
        return None, f"parse err: {e}"

    # A 200 from this very token proves the usage endpoint accepts it, so this probe may RETRACT ITS OWN
    # 401 (self-healing the transient case — a transient 403 was observed in the wild).
    # ★ But it must not overrule proxy.py: the proxy marks dead from a real /responses failure, i.e. the
    # endpoint that actually matters for using the account. If the two endpoints ever disagree about the
    # same token (revocation propagation / rollout), an unconditional clear here would flip auth_dead
    # every cycle — flapping pool membership and, because a revival re-arms the alert, re-notifying on
    # every flip. So each detector may only retract its own verdict; a proxy-marked death stands until
    # the token actually changes (B16 revival via autosync).
    if slot.get("auth_dead") and slot.get("auth_dead_src") == "probe":
        def _revive(st, a=aid):
            sl = st.get("slots", {}).get(a)
            if sl is not None:
                for k in ("auth_dead", "auth_dead_at", "auth_dead_fp", "auth_dead_src"):
                    sl.pop(k, None)
        _mutate_state(_revive)

    rl = d.get("rate_limit") or {}
    pw = _win_from_usage(rl.get("primary_window"))
    sw = _win_from_usage(rl.get("secondary_window"))
    if pw is None and sw is None:
        return None, "HTTP 200 (no rate_limit windows)"
    q = {
        "primary": pw or {"used_percent": None, "window_minutes": None, "resets_at": None},
        "secondary": sw or {"used_percent": None, "window_minutes": None, "resets_at": None},
        "plan_type": d.get("plan_type"), "captured_at": time.time(), "source": "usage-api",
    }
    return q, f"HTTP {status}"


def cmd_refresh_all(args):
    """Refresh EVERY account's quota snapshot to now — one minimal request per account from its own
    token (read-only: never refreshes a refresh_token, never switches the live account). Fixes the
    stale-snapshot problem: SwiftBar otherwise shows a non-active account's quota as of its last switch."""
    s = _state()
    active = s.get("active")
    out, notif, ok_n = [], [], 0
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        q, msg = _probe_quota(aid, slot, aid == active)
        if q:
            _mutate_state(lambda st, a=aid, qq=q: st["slots"].setdefault(a, {}).update(
                {"quota": qq, "quota_status": "ok"}))
            parts = []
            for wkey in ("primary", "secondary"):
                w = q.get(wkey)
                if w and w.get("used_percent") is not None and _win_real(w):
                    rem = 100 - (w["used_percent"] or 0)
                    parts.append(f"{_win_tag(w)}{rem:.0f}%")
            out.append(f"{label}:{'/'.join(parts) if parts else '?'}")
            notif.append(f"{label} {parts[0] if parts else '?'}")
            ok_n += 1
        else:
            out.append(f"{label}:{msg}")
        time.sleep(1.5)  # pacing — the usage endpoint rate-limits bursts (403/429)
    _refresh_menu()
    if "--notify" in args:  # SwiftBar closes the dropdown on tap → a notification is the visible ACK
        total = len(s["slots"])
        body = "  ".join(notif) or "无可刷新账号"
        try:
            subprocess.run(["osascript", "-e",
                            f'display notification "{body}" with title "✅ 额度已刷新 {ok_n}/{total}"'],
                           capture_output=True, timeout=5)
        except Exception:
            pass
    print("refresh-all " + " ".join(out))


