def cmd_refresh(args):
    """Refresh one account (label/id) or 'all' via OAuth. Skips the ACTIVE account
    (codex owns its live token; refreshing it would rotate the token out from under codex)."""
    target = args[0] if args else "all"
    s = _state()
    active = s.get("active")
    out = []
    for aid, slot in s["slots"].items():
        if target not in ("all", aid, slot.get("label")):
            continue
        if aid == active:
            out.append(f"{slot.get('label')}:skip-active")
            continue
        ok, msg = _refresh_slot(aid, slot)
        if msg == "ok":  # persist last_refresh via a fresh RMW — a bulk save here would clobber
            _mutate_state(lambda st, a=aid, v=slot["last_refresh"]:  # concurrent proxy/plugin writes
                          st["slots"].setdefault(a, {}).update({"last_refresh": v}))
        out.append(f"{slot.get('label')}:{'ok' if ok else msg}")
    print("refresh " + (" ".join(out) if out else "(no matching slot)"))


def _slot_access_left_h(slot):
    """Hours until this slot's stored access token expires (None if unreadable)."""
    try:
        tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
    except (OSError, ValueError):
        return None
    return (_access_exp(tok) - time.time()) / 3600


def _codex_running():
    """True if a real `codex` CLI process is running — skip auth.json rotation then (codex owns its live
    token and may be mid-refresh). Conservative: also true during a cxp session (the proxy-routed codex
    binary), which is fine — rotation just waits for the next keepalive run. Ignores our own tooling."""
    try:
        out = subprocess.run(["pgrep", "-fl", "codex"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    for line in out.splitlines():
        low = line.lower()
        if ("codex-rotate" in low or "codex-account-rotator" in low
                or "codexbar" in low or "quota_daemon" in low):
            continue  # our own tooling, not a codex session
        # 只有**裸 codex** 会读/刷 ~/.codex/auth.json;cxp/代理会话(--profile rotateproxy)的 token 由代理
        # 的 auth-token 命令注入、不碰 auth.json → 放行(否则 graph-label 等 cxp 定时任务会一直阻塞轮换)。
        is_codex_bin = ("npm-global/bin/codex" in line or "codex-cli" in low
                        or "/.local/bin/codex" in line)
        if is_codex_bin and "rotateproxy" not in low:
            return True
    return False


def _ensure_live_healthy(s, *, force=False, quiet=False):
    """Keep ~/.codex/auth.json (the account plain `codex` + `omc ask codex` use) SERVER-ALIVE by rotating
    a fresh, server-healthy slot INTO it when the current live account is dead/near-expiry. 用户定稿
    2026-07-16(选项②).

    ★不变量:active 账号**永不被 rotator 原地 OAuth 刷新**(那会和 codex 原生刷新器抢一次性 refresh_token
    → B7/B8/B14 号死)。这里只做「换一个 keepalive 已保鲜的健康号进来」= 与 cmd_switch 同一套凭证移动。
    ★判死活直测 upstream(_probe_quota:200=活/401=服务端已 revoke),不能只看 JWT exp(B21:JWT 没过期
    但服务端已作废)。★codex 在跑时跳过(_codex_running),不覆盖活会话的 auth.json。返回状态串。"""
    if _codex_running():
        return "skip: codex running"
    active = s.get("active")
    active_slot = s["slots"].get(active) if active else None
    # 1) live 账号还服务端活 + JWT 不临近过期? >6h JWT 才值得探(<6h keepalive 该轮换了)。
    if active_slot and LIVE.exists() and not force:
        try:
            left = _access_exp((_load_json(LIVE).get("tokens") or {})) - time.time()
        except (OSError, ValueError):
            left = -1
        if left > 6 * 3600:
            # ★ 死活只问 /models(未被质询),不要用「能否拿到 quota」当判据:/usage 被 Cloudflare 质询时
            # _probe_quota 对健康号也返回 None,会把活着的 live 判成死、且下面所有候选全被跳过 —— 保活
            # 与轮换在质询期整体失效,而这正是 ensure-live 唯一存在的意义。
            if _token_alive((_load_json(LIVE).get("tokens") or {})) is not False:
                return "live healthy (no rotation)"
    # 2) live 死/临近过期 → 找最新鲜的**服务端健康**非活跃 slot,switch 进来。
    candidates = []
    for aid, slot in s["slots"].items():
        if aid == active or (slot.get("cooling_until") or 0) > time.time():
            continue
        try:
            tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
        except (OSError, ValueError, KeyError):
            continue
        jwt_left = _access_exp(tok) - time.time()
        if jwt_left < 6 * 3600:  # JWT 太近过期(keepalive 本该刷过)→ 跳,别换个也快死的进来
            continue
        try:
            cand_tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
        except (OSError, ValueError):
            continue
        if _token_alive(cand_tok) is not True:   # 只接受确证存活的候选(未知也不换)
            continue
        candidates.append((jwt_left, aid, slot))
    if not candidates:
        return "no server-healthy slot to rotate in (\\codex login 补活号 / 等 keepalive 刷)"
    candidates.sort(key=lambda c: c[0], reverse=True)  # JWT 最新鲜优先
    _, target, tslot = candidates[0]
    # 3) 凭证移动 = cmd_switch 同款:syncback 现 live→其槽,再锁内 slot→LIVE→activate→save。
    _syncback(s)
    with _cred_lock():
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    who = tslot.get("label", _mask(target))
    if not quiet:
        print(f"[ensure-live] rotated auth.json → [{who}] (server-healthy; plain codex/omc 现在有活号)")
    return f"rotated → [{who}]"


def cmd_ensure_live(args):
    """选项②手动入口:检测 ~/.codex/auth.json 死/临近过期 → 轮换一个服务端健康号进来。`--force` 强制轮换。"""
    s = _state()
    _autosync_live(s)
    msg = _ensure_live_healthy(s, force="--force" in args)
    print(f"ensure-live: {msg}")


def cmd_keepalive(args):
    """Keep idle accounts' tokens alive via OAuth refresh — cheap, no quota, no auth.json swap.
    Refreshes NON-active accounts whose access token expires within N hours (default 48 — wider than
    the 24h daily cadence, so a token is renewed the run BEFORE it would expire; this both closes the
    idle-token gap and keeps last_refresh current). The active account is skipped (codex owns its live
    token). `--dry-run` lists targets only. Was: last_refresh>4d — but B9 skip-if-valid froze
    last_refresh while tokens stayed healthy, so that gate never fired."""
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    thresh_h = float(pos[0]) if pos else 48.0
    s = _state()
    active = s.get("active")
    refreshed, skipped = [], []
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        if aid == active:
            skipped.append(f"{label}:active")
            continue
        left = _slot_access_left_h(slot)
        if dry:
            tgt = left is not None and left <= thresh_h
            (refreshed if tgt else skipped).append(f"{label}:{'?' if left is None else round(left)}h-left")
            continue
        ok, msg = _refresh_slot(aid, slot, min_valid_seconds=thresh_h * 3600)
        if msg == "ok":  # real refresh → persist last_refresh via targeted RMW (bulk save would clobber)
            _mutate_state(lambda st, a=aid, v=slot["last_refresh"]:
                          st["slots"].setdefault(a, {}).update({"last_refresh": v}))
            refreshed.append(f"{label}:ok")
        else:
            skipped.append(f"{label}:{msg}")  # 'still valid' / 'skip-active' are NO-OPS — not refreshes
    print(f"keepalive refreshed=[{', '.join(refreshed) or 'none'}] skipped=[{', '.join(skipped)}]")
    # 选项②(2026-07-16):keepalive 尾部保活 ~/.codex/auth.json——非活跃号已刷新鲜,这里把最新鲜的
    # 服务端健康号轮进 auth.json,让裸 codex / omc ask codex 也一直有活号。重读 state 拿 _mutate_state
    # 刚落盘的 last_refresh,避免 _ensure_live_healthy 的 _save_state 回滚 keepalive 的更新。
    if not dry:
        print(f"ensure-live: {_ensure_live_healthy(_state())}")


def cmd_quota(args):
    """Print live quota of the active account; --save stamps quota + identity into the active slot."""
    s = _state()
    _autosync_live(s)
    p = _newest_rollout()
    # If the rotating proxy recently produced the newest rollout, it already accounted per-request;
    # attributing that rollout to the codex-rotate "active" account would mis-attribute. Skip then.
    proxy_owns = (p is not None and s.get("last_proxy_ts", 0) > 0
                  and p.stat().st_mtime <= s["last_proxy_ts"] + 12)
    q = None if proxy_owns else _attributable_quota(s)
    if "--save" in args and not proxy_owns:
        aid = s.get("active")
        if aid:
            slot = s["slots"].setdefault(aid, {})
            probe_is_fresher = _server_reading_is_fresher(slot.get("quota"), q)
            if q and not probe_is_fresher:
                slot["quota"] = q          # fresh reading attributable to this account (plain codex)
                slot["quota_status"] = "ok"
            elif q and probe_is_fresher:
                pass  # keep the newer manual probe; the older rollout is behind live
            elif slot.get("quota"):
                pass  # keep the last snapshot (proxy OR a prior plain-codex reading) — a stale snapshot
                      # beats '用量未知' when you switch back to an account; the leak is gated by Fix A
            else:
                since = s.get("active_since", 0)
                if p and since and p.stat().st_mtime >= since:
                    slot["quota_status"] = "empty"    # ran this stint but rollout had no rate_limit telemetry
                else:
                    slot["quota_status"] = "pending"  # never ran this account — no snapshot to show
            if LIVE.exists():
                _stamp_identity(slot, _load_json(LIVE), expect_aid=aid)
            if p and not _rollout_is_proxy(p):
                s["last_plain_ts"] = p.stat().st_mtime  # newest plain-codex activity — the title's
            _save_state(s)                              # cxp-vs-plain arbitration signal
    print(json.dumps(q, ensure_ascii=False) if q else "null")


USAGE_PATH = "/backend-api/codex/usage"
# Reset credits ("重置卡") — a granted one-shot that clears an exhausted rate-limit window. Two tiers,
# because the cheap one carries no dates:
#   • /usage    — rides along free on every quota probe, but only {available_count,
#                 applicable_available_count}. No expiry, no per-credit identity.
#   • this path — the actual list: id / status / granted_at / expires_at / title. Rate-limited HARD
#                 (two calls back-to-back already return 429 `connector_rate_limit`), so it is fetched
#                 only when the free count says there is something to list. Verified 2026-07-30.
CREDITS_PATH = "/backend-api/codex/rate-limit-reset-credits"
CREDIT_DETAIL_TTL = 12 * 3600      # dates are near-static; a stale-by-hours cache is fine
CREDIT_EXPIRY_WARN_DAYS = 3.0
CREDIT_PACE_SECS = 20              # between accounts, to stay under connector_rate_limit
# Liveness endpoint. /usage carries a Cloudflare bot challenge (403 for every client, healthy or not),
# so it cannot answer "is this token revoked". /models is unchallenged, is a GET, costs no quota, and
# still 401s on a revoked token — which makes it the reliable health signal.
MODELS_PATH = "/backend-api/codex/models?client_version=0.146.0"


def _tls_is_stale():
    """True when this interpreter's TLS stack is the ancient LibreSSL that Cloudflare fingerprints.

    ★ MEASURED 2026-08-01, single variable, 3 trials each, same token / headers / IP / minute:
        /usr/bin/python3        LibreSSL 2.8.3   GET /usage → 403, 403, 403
        /opt/homebrew/bin/py3   OpenSSL 3.6.3    GET /usage → 200, 200, 200
    So a 403 here is a property of the CLIENT BINARY, not of the endpoint, the account, or our request
    rate. This function exists so that verdict is stated in the log instead of being re-derived: the
    previous investigation concluded "the endpoint is challenged for everyone" partly because macOS
    `curl` also links LibreSSL and reproduced the 403 — same failure mode, mistaken for corroboration."""
    return ssl.OPENSSL_VERSION.startswith("LibreSSL")


def _api_get(tok, path, timeout=25):
    """GET an authenticated Codex backend path with this account's token. -> (status, body|b'')."""
    conn = http.client.HTTPSConnection("chatgpt.com", 443, context=ssl.create_default_context(), timeout=timeout)
    try:
        conn.request("GET", path, headers={
            "Authorization": f"Bearer {tok.get('access_token', '')}",
            "chatgpt-account-id": tok.get("account_id"),
            "originator": "codex_cli_rs", "User-Agent": "codex_cli_rs/0.146.0",
            "Accept": "application/json"})
        r = conn.getresponse()
        return r.status, r.read()
    except Exception as e:
        return None, str(e).encode()   # keep the cause; callers otherwise只看到 "req err"
    finally:
        conn.close()


def _revive_if_probe_marked(aid, slot):
    """Clear an auth_dead that THIS probe set, once the server accepts the token again.
    ★ Must be callable from the 403 path too: the revive used to sit after the /usage 200 branch, which
    is unreachable while /usage is bot-challenged — so a single transient 401 stuck an account dead for
    as long as the challenge lasted, with `health` printing "服务端:活" and "DEAD" on the same line.
    Only retracts probe-set deaths; a proxy-set death still needs a genuinely new token (B16)."""
    if not (slot.get("auth_dead") and slot.get("auth_dead_src") == "probe"):
        return False
    def _f(st, a=aid):
        sl = st.get("slots", {}).get(a)
        if sl is not None:
            for k in ("auth_dead", "auth_dead_at", "auth_dead_fp", "auth_dead_src"):
                sl.pop(k, None)
    _mutate_state(_f)
    slot.pop("auth_dead", None)
    return True


def _token_alive(tok, timeout=8):
    """True / False / None(unknown) — is this token still accepted by the server?
    Uses /models because /usage is behind a bot challenge; 401 here is a genuine revocation."""
    st, _ = _api_get(tok, MODELS_PATH, timeout=timeout)
    if st == 200:
        return True
    if st == 401:
        return False
    return None


def _win_from_usage(w):
    """Map one usage-API window {used_percent, limit_window_seconds, reset_at} → our snapshot shape."""
    if not isinstance(w, dict) or w.get("used_percent") is None:
        return None
    secs = w.get("limit_window_seconds")
    reset = w.get("reset_at")
    if reset is None and w.get("reset_after_seconds") is not None:
        reset = time.time() + w["reset_after_seconds"]
    return {
        "used_percent": float(w["used_percent"]),
        "window_minutes": (float(secs) / 60.0) if secs else None,
        "resets_at": float(reset) if reset is not None else None,
    }


def _probe_quota(aid, slot, is_active):
    """Read live quota from Codex's OFFICIAL account-usage endpoint — GET, so it costs ZERO quota.

    ★ Replaces the old probe, which sent a real `POST /backend-api/codex/responses` just to read the
    x-codex-* response headers: that was a billed completion, so every refresh burned real quota (a big
    deal since Codex retired the 5h window for a small weekly one). The Codex CLI binary itself exposes
    GetAccountRateLimitsResponse via `GET /backend-api/codex/usage`; verified 2026-07-30 to return
    {rate_limit:{primary_window:{used_percent,limit_window_seconds,reset_at},secondary_window},plan_type}
    for BOTH active and non-active accounts, and 401 for revoked ones (doubles as a health check).

    Read-only on the token (never OAuth-refreshes — the active account's live token stays codex-owned);
    active reads live auth.json, inactive reads its slot file. Returns (quota_dict|None, msg)."""
    authpath = LIVE if is_active else (AUTH_DIR / slot["file"])
    try:
        auth = _load_json(authpath)
        tok = (auth.get("tokens") or {})
    except (OSError, ValueError) as e:
        return None, f"read err: {e}"
    # ★ Invariant: the token we probe must BELONG to the account we attribute the result to. Violating
    # it now costs more than a wrong number — a 401 marks that account dead and a 200 revives it, i.e.
    # it changes pool membership. Both branches are checked:
    #   • active   — refresh-all walks the pool over seconds, and a switch (CodexBar / cxp / ensure-live)
    #     landing mid-loop leaves LIVE holding a DIFFERENT account's token.
    #   • inactive — auth/<aid>.json should always hold account <aid>, so a mismatch means the slot file
    #     is corrupt or was hand-edited; attributing it is worse than reporting nothing.
    if _account_id(auth) != aid:
        return None, ("live account switched mid-probe" if is_active
                      else "slot file/account mismatch — not attributing")
    if _access_exp(tok) - time.time() < 60:
        return None, "token expired (\\codex login / wait keepalive)"
    # ★ Cloudflare puts a BOT CHALLENGE on /usage (`cf-mitigated: challenge` -> 403 HTML), and it is
    # sticky: every account 403s, including the healthy active one, and curl is challenged just like
    # Python — so it is the ENDPOINT, not our client or the accounts. Meanwhile /models answers 200 for
    # the very same token. A 403 therefore says NOTHING about the account, and treating it as a signal
    # is what made a fully healthy pool look dead. Liveness now comes from /models (unchallenged, GET,
    # no quota); /usage is only for the numbers, and its 403 degrades to "quota unknown".
    status, raw = _api_get(tok, USAGE_PATH, timeout=30)
    if status is None:
        return None, "req err"

    # A 403 on /usage is the bot challenge, never an account verdict — resolve liveness on /models and
    # report quota as unknown. Only escalate to "revoked" when the UNCHALLENGED endpoint agrees.
    if status in (403, 429):
        alive = _token_alive(tok)
        if alive is False:
            status = 401                       # fall through to the dead-marking path below
        else:
            if alive is True:
                _revive_if_probe_marked(aid, slot)   # reachable even while /usage is challenged
            # Name the client-side cause when it applies — a bare "被质询" sent the last investigation
            # chasing the endpoint and the request rate for hours.
            if _tls_is_stale():
                return None, (f"额度接口 403 — 本解释器 TLS 过旧({ssl.OPENSSL_VERSION})被指纹拦截,"
                              f"换 /opt/homebrew/bin/python3 跑")
            return None, "额度接口被 Cloudflare 质询(账号正常)" if alive else "额度接口被质询(死活未知)"

    # ★ 401 = the server says this token is REVOKED — the local JWT exp was checked above, so this is the
    # "valid-looking but server-side dead" case `health` cannot detect (B21). Until now only proxy.py set
    # auth_dead, so an account dying while IDLE kept showing a stale snapshot: plus7 sat at a 26h-old
    # "0% remaining" that reads as quota exhaustion when the token had been revoked. auth_dead_fp = tail
    # of the REJECTED token, preserving B16's revival gate.
    if status == 401:
        fp = (tok.get("access_token") or "")[-16:] or None
        def _dead(st, a=aid, f=fp):
            sl = st.get("slots", {}).get(a)
            if sl is not None:
                already = sl.get("auth_dead")
                sl["auth_dead"] = True
                if not already:                       # keep the ORIGINAL death time — the UI treats a
                    sl["auth_dead_at"] = time.time()  # changed timestamp as a NEW death event
                if not already:                       # never overwrite another detector's verdict
                    sl["auth_dead_src"] = "probe"
                if f:
                    sl["auth_dead_fp"] = f
        _mutate_state(_dead)
        return None, "HTTP 401 (token revoked — \\codex login)"
    if status in (403, 429):
        return None, f"HTTP {status} (限流,稍后自动重试)"
    if status != 200:
        return None, f"HTTP {status}"
    try:
        d = json.loads(raw)
    except ValueError as e:
        return None, f"parse err: {e}"

    # A 200 from this very token proves the usage endpoint accepts it, so this probe may RETRACT ITS OWN
    # 401 (self-healing the transient case — a transient 403 was observed in the wild).
    # ★ But it must not overrule proxy.py: the proxy marks dead from a real /responses failure, i.e. the
    # endpoint that actually matters for using the account. If the two endpoints ever disagree about the
    # same token (revocation propagation / rollout), an unconditional clear here would flip auth_dead
    # every cycle — flapping pool membership and, because a revival re-arms the alert, re-notifying on
    # every flip. So each detector may only retract its own verdict; a proxy-marked death stands until
    # the token actually changes (B16 revival via autosync).
    _revive_if_probe_marked(aid, slot)

    # ★ Reset-credit counts ride along free on this same response — but they must NOT be nested inside
    # `quota`: quotad rewrites slot["quota"] every 15s from a local rollout event, which carries no
    # credit field, so nesting would blank the count on the very next tick. Sibling key, written here.
    # Recorded BEFORE the no-windows early return, since the counts are valid either way.
    rc = d.get("rate_limit_reset_credits")
    if isinstance(rc, dict):
        def _cred(st, a=aid, r=rc):
            sl = st.get("slots", {}).get(a)
            if sl is not None:
                sl["credits"] = {"available": r.get("available_count"),
                                 "applicable": r.get("applicable_available_count"),
                                 "at": time.time()}
        _mutate_state(_cred)
        slot["credits"] = {"available": rc.get("available_count"),
                           "applicable": rc.get("applicable_available_count"), "at": time.time()}

    rl = d.get("rate_limit") or {}
    pw = _win_from_usage(rl.get("primary_window"))
    sw = _win_from_usage(rl.get("secondary_window"))
    if pw is None and sw is None:
        return None, "HTTP 200 (no rate_limit windows)"
    q = {
        "primary": pw or {"used_percent": None, "window_minutes": None, "resets_at": None},
        "secondary": sw or {"used_percent": None, "window_minutes": None, "resets_at": None},
        "plan_type": d.get("plan_type"), "captured_at": time.time(), "source": "usage-api",
    }
    return q, f"HTTP {status}"


def cmd_refresh_all(args):
    """Refresh EVERY account's quota snapshot to now — one minimal request per account from its own
    token (read-only: never refreshes a refresh_token, never switches the live account). Fixes the
    stale-snapshot problem: SwiftBar otherwise shows a non-active account's quota as of its last switch."""
    s = _state()
    active = s.get("active")
    out, notif, ok_n = [], [], 0
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        q, msg = _probe_quota(aid, slot, aid == active)
        if q:
            _mutate_state(lambda st, a=aid, qq=q: st["slots"].setdefault(a, {}).update(
                {"quota": qq, "quota_status": "ok"}))
            parts = []
            for wkey in ("primary", "secondary"):
                w = q.get(wkey)
                if w and w.get("used_percent") is not None and _win_real(w):
                    rem = 100 - (w["used_percent"] or 0)
                    parts.append(f"{_win_tag(w)}{rem:.0f}%")
            out.append(f"{label}:{'/'.join(parts) if parts else '?'}")
            notif.append(f"{label} {parts[0] if parts else '?'}")
            ok_n += 1
        else:
            out.append(f"{label}:{msg}")
        time.sleep(1.5)  # pacing — the usage endpoint rate-limits bursts (403/429)
    _refresh_menu()
    if "--notify" in args:  # SwiftBar closes the dropdown on tap → a notification is the visible ACK
        total = len(s["slots"])
        body = "  ".join(notif) or "无可刷新账号"
        try:
            subprocess.run(["osascript", "-e",
                            f'display notification "{body}" with title "✅ 额度已刷新 {ok_n}/{total}"'],
                           capture_output=True, timeout=5)
        except Exception:
            pass
    print("refresh-all " + " ".join(out))


def _resolve_slot(s, key):
    """label 或 account_id → aid。None 表示没匹配上。"""
    return next((aid for aid, sl in s["slots"].items()
                 if aid == key or sl.get("label") == key), None)


# 计费探测的默认模型与推理档。/models 当前给 gpt-5.6-{sol,terra,luna} / gpt-5.5 / gpt-5.4 /
# gpt-5.4-mini / codex-auto-review。默认取 gpt-5.4 + effort=low:够小,又是真正在用的主力档位,
# 比 mini 更能代表"日常真能不能干活"。实测单次探测没能让 used_percent 的整数位动(Δ+0%),
# 即成本 < 1% —— 这是上界不是点估计,别当"几乎免费"用。
PROBE_MODEL = "gpt-5.4"
PROBE_EFFORT = "low"
PROBE_PROMPT = "hi"
PROBE_EXPECT = "ok"      # instructions 要求原样回这两个字母;拿它核对"真的答出话"
RESPONSES_PATH = "/backend-api/codex/responses"
PROBE_READ_CAP = 256 * 1024   # SSE 正文读取上限,防病态长流把探针拖死


def _sse_answer(raw):
    """把 SSE 正文里的 output_text.delta 拼回模型的实际回答。

    ★ 判"能用"必须看到这段文字,不能只看 HTTP 200:200 只说明请求被受理,流在中途断掉、模型没吐字
    也照样是 200,那种情况报"能用"就是假阳性。"""
    text = []
    for line in raw.split(b"\n"):
        if not line.startswith(b"data: "):
            continue
        try:
            d = json.loads(line[6:])
        except ValueError:
            continue
        if d.get("type") == "response.output_text.delta":
            text.append(d.get("delta", ""))
    return "".join(text).strip()


def _billed_probe(aid, slot, is_active, model=PROBE_MODEL, effort=PROBE_EFFORT):
    """★ 发一次真实(计费)补全,证明这个号**真的能干活**。-> (quota|None, msg, answer)。

    与 _probe_quota 的分工:
      • _probe_quota  GET /usage   零消耗,只读数字。答"服务端记的额度是多少"。
      • 本函数        POST /responses  真计费。答"这个号现在还能不能真的完成一次请求"。
    `/models` 返回 200 只证明 token 被接受;订阅到期、模型权限被撤、账号被限流这些,只有真发一次
    补全才暴露得出来。副产品是响应头里的 x-codex-* 全套额度(与 /usage 同源)。

    ★ 本函数**不标记 auth_dead**。标死会改变号池成员资格,而现有的两个检测器(proxy 的 /responses
    失败、_probe_quota 的 401)都带着防抖/防翻转的守卫;一个测试工具再插一只手进来,只会把"两个端点
    互相打架 → 每轮翻转 → 反复重发告警"那类问题请回来。它只报告,由人决定。

    token 只读,绝不 OAuth 刷新(active 号的 token 归 codex 原生刷新器所有,见 B14)。"""
    authpath = LIVE if is_active else (AUTH_DIR / slot["file"])
    try:
        auth = _load_json(authpath)
        tok = (auth.get("tokens") or {})
    except (OSError, ValueError) as e:
        return None, f"read err: {e}", ""
    # 与 _probe_quota 相同的归属不变量:探的 token 必须属于要归账的那个号。
    if _account_id(auth) != aid:
        return None, ("live account switched mid-probe" if is_active
                      else "slot file/account mismatch — not attributing"), ""
    if _access_exp(tok) - time.time() < 60:
        return None, "token expired (codex-rotate login / wait keepalive)", ""

    body = json.dumps({
        "model": model,
        "instructions": f"Reply with exactly: {PROBE_EXPECT}",
        "input": [{"type": "message", "role": "user",
                   "content": [{"type": "input_text", "text": PROBE_PROMPT}]}],
        "reasoning": {"effort": effort},
        "stream": True, "store": False,
    }).encode()
    conn = http.client.HTTPSConnection("chatgpt.com", 443,
                                       context=ssl.create_default_context(), timeout=60)
    try:
        conn.request("POST", RESPONSES_PATH, body=body, headers={
            "Authorization": f"Bearer {tok.get('access_token', '')}",
            "chatgpt-account-id": tok.get("account_id"),
            "Content-Type": "application/json", "originator": "codex_cli_rs",
            "User-Agent": "codex_cli_rs/0.146.0",
            "Accept": "text/event-stream", "Content-Length": str(len(body))})
        r = conn.getresponse()
        h = {k.lower(): v for k, v in r.getheaders()}
        status = r.status
        raw = r.read(PROBE_READ_CAP)   # 读全:要从中抽出模型的实际回答,而不只是判状态码
    except Exception as e:
        # ★ 传输层失败 ≠ 账号不能用,而"把这两者分开"正是本工具存在的理由。实测 plus4 报过一次
        # `SSL: UNEXPECTED_EOF_WHILE_READING`,紧接着连测三次全部 200 —— 纯抖动。不重试就会把一次
        # 网络打嗝写成"这个号挂了",比不测更糟。只重试连接/TLS 层异常;HTTP 状态码是服务端的判决,
        # 不在此列(见下面按 status 分支)。
        return None, f"req err: {e}", ""
    finally:
        conn.close()

    if status == 401:
        return None, "HTTP 401 (token 被作废 — codex-rotate login 重登)", ""
    if status != 200:
        detail = raw[:120].decode(errors="replace").replace("\n", " ")
        return None, f"HTTP {status} {detail}", ""

    answer = _sse_answer(raw)
    if not answer:
        return None, "HTTP 200 但模型没吐字(流中断?)", ""

    def num(key):
        try:
            return float(h[key])
        except (KeyError, ValueError, TypeError):
            return None

    pu, su = num("x-codex-primary-used-percent"), num("x-codex-secondary-used-percent")
    if pu is None and su is None:
        return None, "HTTP 200 (响应头无额度字段)", answer
    q = {
        "primary": {"used_percent": pu, "window_minutes": num("x-codex-primary-window-minutes"),
                    "resets_at": num("x-codex-primary-reset-at")},
        "secondary": {"used_percent": su, "window_minutes": num("x-codex-secondary-window-minutes"),
                      "resets_at": num("x-codex-secondary-reset-at")},
        "plan_type": h.get("x-codex-plan-type"),
        "captured_at": time.time(), "source": "probe",
    }
    return q, "HTTP 200", answer


def cmd_probe(args):
    """★ 计费探针:对指定号各发一次最小真实补全("hi" → "ok"),验证它**真的能用**,并顺带把
    响应头里的额度写回 state。

    用法:
        codex-rotate probe plus5 plus7      # 指定号
        codex-rotate probe --all            # 全池(需显式,防手滑烧全池)
        codex-rotate probe --all --model gpt-5.5

    ★ 这会花真钱(周额度)。项目当初正是因为**自动**计费探测每天烧掉 17-18% 才把它废掉的 ——
    所以它没有接进 quotad、没有接进 CodexBar 按钮、也没有任何定时器会调它。只在你手动敲的时候跑。
    日常看额度请用零消耗的 `refresh-all`。

    每号打印 探测前 → 探测后(前值取自免费的 /usage,后值取自本次探测的响应头),这样单次真实成本
    永远是当场可见的,而不是靠我给你一个记在文档里、可能早就过期的数字。"""
    model, effort = PROBE_MODEL, PROBE_EFFORT
    for flag, setter in (("--model", "model"), ("--effort", "effort")):
        if flag in args:
            i = args.index(flag)
            if i + 1 >= len(args):
                sys.exit(f"{flag} 后面要跟值")
            if setter == "model":
                model = args[i + 1]
            else:
                effort = args[i + 1]
            args = args[:i] + args[i + 2:]
    take_all = "--all" in args
    labels = [a for a in args if not a.startswith("--")]

    s = _state()
    if take_all:
        targets = [aid for aid, sl in s["slots"].items() if not sl.get("auth_dead")]
    elif labels:
        targets = []
        for key in labels:
            aid = _resolve_slot(s, key)
            if not aid:
                sys.exit(f"no slot matching '{key}'")
            targets.append(aid)
    else:
        sys.exit("要探哪些号?给 label(codex-rotate probe plus5 plus7)或 --all")
    if not targets:
        sys.exit("没有可探测的号(全部标记为失效)")

    active = s.get("active")
    print(f"计费探测 · model={model} effort={effort} · {len(targets)} 个号 "
          f"—— 每号一次真实请求(问「{PROBE_PROMPT}」),会消耗周额度")
    ok_n = 0
    for i, aid in enumerate(targets):
        slot = s["slots"][aid]
        label = slot.get("label", _mask(aid))
        if i:
            time.sleep(2.0)          # 端点对突发有脾气,同 refresh-all 的节流思路

        before = None
        pre, _ = _probe_quota(aid, slot, aid == active)   # 免费 GET,拿探测前基线
        if pre:
            before = (pre.get("primary") or {}).get("used_percent")

        q, msg, answer = _billed_probe(aid, slot, aid == active, model, effort)
        # 传输层抖动重试一次。只对 `req err` 重试 —— 那是连不上/握手断,没有产生任何服务端判决;
        # HTTP 4xx/5xx 是服务端明确回答了,重试只会白烧一次额度。
        if not q and msg.startswith("req err"):
            time.sleep(3)
            q, msg2, answer = _billed_probe(aid, slot, aid == active, model, effort)
            msg = msg2 if q else f"{msg}(重试后:{msg2})"
        if not q:
            print(f"  [{label:<8}] ✗ {msg}")
            continue
        ok_n += 1
        after = (q.get("primary") or {}).get("used_percent")
        _mutate_state(lambda st, a=aid, qq=q: st["slots"].setdefault(a, {}).update(
            {"quota": qq, "quota_status": "ok"}))
        delta = "" if before is None or after is None else f"  (Δ{after - before:+.0f}%)"
        # 把模型的原话打出来 —— 这才是"能答"的证据。答非所问(不含期望词)标 ⚠️ 但不算失败:
        # 模型偶尔加标点/换措辞,那不代表账号有问题,只是不该被静默当成完美通过。
        odd = "" if PROBE_EXPECT in answer.lower() else " ⚠️答非所问"
        print(f"  [{label:<8}] ✓ 答「{answer[:40]}」{odd} · "
              f"周已用 {before if before is not None else '?'}% → {after:.0f}%{delta}")
    print(f"probe {ok_n}/{len(targets)} 可用")
    _refresh_menu()


def _credit_days_left(c, now=None):
    ts = _iso_ts(c.get("expires_at"))
    return None if ts is None else (ts - (now or time.time())) / 86400.0


def _soonest_credit(slot):
    """Days until the nearest still-available credit expires, from the cached detail. None if unknown."""
    soon = None
    for c in ((slot.get("credits_detail") or {}).get("credits") or []):
        if c.get("status") != "available":
            continue
        d = _credit_days_left(c)
        if d is not None and d > 0 and (soon is None or d < soon):
            soon = d
    return soon


def _credit_fmt(slot):
    """Count comes from the free /usage summary; the expiry warning needs the cached detail, so an
    account that has never run `credits` shows the count alone rather than a fake all-clear."""
    n = (slot.get("credits") or {}).get("available")
    if not n:
        return ""
    soon = _soonest_credit(slot)
    if soon is not None and soon <= CREDIT_EXPIRY_WARN_DAYS:
        return f"  卡:{n}(⚠{soon:.1f}天后过期)"
    return f"  卡:{n}"


def _fetch_credit_detail(aid, slot, is_active):
    """One account's reset-credit list, the only source of per-credit expires_at. -> (list|None, msg)."""
    authpath = LIVE if is_active else (AUTH_DIR / slot["file"])
    try:
        auth = _load_json(authpath)
        tok = (auth.get("tokens") or {})
    except (OSError, ValueError) as e:
        return None, f"read err: {e}"
    # Same attribution invariant as _probe_quota: a live switch mid-loop leaves LIVE holding another
    # account's token, and credits are per-account.
    if _account_id(auth) != aid:
        return None, ("live account switched mid-fetch" if is_active
                      else "slot file/account mismatch — not attributing")
    if _access_exp(tok) - time.time() < 60:
        return None, "token expired (codex-rotate login / wait keepalive)"
    st, raw = _api_get(tok, CREDITS_PATH, timeout=20)
    if st == 429:
        return None, "HTTP 429 (端点限流,稍后再试)"
    if st != 200:
        return None, f"HTTP {st}"
    try:
        d = json.loads(raw)
    except ValueError as e:
        return None, f"parse err: {e}"
    return (d.get("credits") or []), "HTTP 200"


def cmd_credits(args):
    """重置卡:每个账号有几张、每张什么时候过期。

    数量走免费层(每次额度探测都带回来,零额外请求);到期时间只有明细端点有,而它限流很凶,所以只在
    「免费计数 > 0 且缓存过期/计数变了」时才打,并在账号之间限速。--force 绕过缓存。

    ★ applicable_available_count 的门槛尚未确定:目前 2 次观测(周用量 0% 和 74%)都是 0,说明"有卡"
    不等于"现在能用"。同样能解释这组数据的至少有「必须 limit_reached」和「必须超过某个高水位」两种,
    现有证据无法区分。判别实验是免费的:盯着高用量那个号的 applicable 在 used_percent 爬升时何时翻正
    ——所以下面只如实呈现两个计数,不替服务端推断可用性。"""
    force = "--force" in args
    as_json = "--json" in args
    s = _state()
    active = s.get("active")
    now = time.time()
    rows, fetched = [], 0
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        if slot.get("auth_dead"):
            rows.append({"label": label, "email": slot.get("email"), "dead": True})
            continue
        summary = slot.get("credits") or {}
        n = summary.get("available")
        cached = slot.get("credits_detail") or {}
        stale = (now - cached.get("fetched_at", 0) > CREDIT_DETAIL_TTL
                 or cached.get("available") != n)
        msg = "cached"
        if n and (force or stale):
            if fetched:
                time.sleep(CREDIT_PACE_SECS)
            fetched += 1
            credits, msg = _fetch_credit_detail(aid, slot, aid == active)
            if credits is not None:
                cached = {"credits": credits, "available": n, "fetched_at": time.time()}
                _mutate_state(lambda st, a=aid, c=cached: (st.get("slots", {}).get(a) or {}).update(
                    {"credits_detail": c}))
                slot["credits_detail"] = cached
        rows.append({"label": label, "email": slot.get("email"), "dead": False,
                     "available": n, "applicable": summary.get("applicable"),
                     "credits": cached.get("credits") or [], "msg": msg})
    if as_json:
        print(json.dumps(rows, ensure_ascii=False))
        return
    for r in rows:
        who = r.get("email") or "?"
        if r["dead"]:
            print(f"  [{r['label']:<8}] {who:<26} ✗DEAD")
            continue
        n = r.get("available") or 0
        head = f"  [{r['label']:<8}] {who:<26} {n} 张可用"
        if n and r.get("applicable") == 0:
            head += "(当前无可重置的窗口)"
        print(head)
        for c in r["credits"]:
            if c.get("status") != "available":
                continue
            d = _credit_days_left(c)
            ts = _iso_ts(c.get("expires_at"))
            when = (datetime.datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")
                    if ts is not None else "?")
            left = "" if d is None else f"  剩 {d:.1f} 天"
            warn = " ⚠️" if d is not None and d <= CREDIT_EXPIRY_WARN_DAYS else ""
            print(f"      · {c.get('title', '重置卡')}  到期 {when}{left}{warn}")
        if n and not r["credits"]:
            print(f"      (到期时间未取到: {r['msg']})")


TOKENS_CACHE = STORE / ".tokens-cache.json"


def _scan_tokens(days=90):
    """按天汇总 token 消耗。-> {"YYYY-MM-DD": {in,out,reason,cached,total,turns}}

    ★ 口径:逐轮累加 `last_token_usage`,**不是** `total_token_usage`。后者是会话累计值,跨事件求和会
    重复计数;实测单个会话「逐轮 last 求和 == 末条 total」(4,316,795 == 4,316,795,42 轮),所以
    逐轮求和才是这段时间真实烧掉的量。
    ★ input 每轮都含完整上下文、重发即重计费(实测 cached_tokens 恒 0,该端点拒绝 store:true,没有
    prompt cache 可省),所以这里不做任何"扣掉重复上下文"的修正 —— 那样反而会低估账单。
    ★ rollout **不记账号**,所以这只能是全池合计,无法拆到某个号。这也正是它想回答的问题。

    增量缓存:按 (mtime, size) 判定文件是否变过,没变直接用上次的结果。3508 个文件全解析要分钟级,
    有缓存后只解析当天在写的那几个。"""
    try:
        cache = _load_json(TOKENS_CACHE)
    except (OSError, ValueError):
        cache = {}
    files_cache = cache.get("files") or {}
    cut = time.time() - days * 86400
    out, fresh = {}, {}
    scanned = reused = 0

    for f in SESSIONS.rglob("rollout-*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        if st.st_mtime < cut:
            continue
        key = str(f)
        sig = [int(st.st_mtime), st.st_size]
        hit = files_cache.get(key)
        if hit and hit.get("sig") == sig:
            per_day = hit["days"]; reused += 1
        else:
            per_day = {}
            try:
                txt = f.read_text(errors="replace")
            except OSError:
                continue
            if '"token_count"' in txt:
                # ★ 模型按 **ordinal 顺序** 归属:每个 token_count 记到它之前最近一次 turn_context 的
                # model。不能按会话整体归 —— 实测 310 个文件里有 5 个在会话中途换过模型。
                cur_model = None
                for line in txt.splitlines():
                    if '"turn_context"' in line:
                        try:
                            td = json.loads(line)
                        except ValueError:
                            continue
                        if td.get("type") == "turn_context":
                            m = (td.get("payload") or {}).get("model")
                            if m:
                                cur_model = m
                        continue
                    if '"token_count"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    pl = d.get("payload") or {}
                    if pl.get("type") != "token_count":
                        continue
                    lt = (pl.get("info") or {}).get("last_token_usage") or {}
                    tot = lt.get("total_tokens") or 0
                    if not tot:
                        continue
                    day = (d.get("timestamp") or "")[:10]
                    if not day:
                        continue
                    b = per_day.setdefault(day, [0, 0, 0, 0, 0, 0, {}])
                    b[0] += lt.get("input_tokens") or 0
                    b[1] += lt.get("output_tokens") or 0
                    b[2] += lt.get("reasoning_output_tokens") or 0
                    b[3] += lt.get("cached_input_tokens") or 0
                    b[4] += tot
                    b[5] += 1
                    mk = cur_model or "unknown"
                    mb = b[6].setdefault(mk, [0, 0])
                    mb[0] += tot; mb[1] += 1
            scanned += 1
        fresh[key] = {"sig": sig, "days": per_day}
        for day, b in per_day.items():
            o = out.setdefault(day, [0, 0, 0, 0, 0, 0, {}])
            for i in range(6):
                o[i] += b[i]
            for mk, mv in (b[6] if len(b) > 6 else {}).items():
                t2 = o[6].setdefault(mk, [0, 0])
                t2[0] += mv[0]; t2[1] += mv[1]

    try:
        _atomic_write(TOKENS_CACHE, {"files": fresh}, mode=0o644)  # 无凭证,不必 0600
    except Exception:
        pass   # 缓存是加速手段,写不进去不该让统计失败
    keys = ("input", "output", "reasoning", "cached", "total", "turns")
    return ({d: {**dict(zip(keys, b[:6])),
                 "models": {k: {"total": v[0], "turns": v[1]} for k, v in (b[6] or {}).items()}}
             for d, b in out.items()},
            {"scanned": scanned, "reused": reused})


def cmd_tokens(args):
    """全池 token 消耗按天统计。`--json` 给 GUI 用,`--days N` 改窗口。

    数据源是 codex 自己写的 rollout(`~/.codex/sessions/**/rollout-*.jsonl`)里的 `token_count`
    事件 —— 不联网、不消耗任何额度。"""
    days = 30
    if "--days" in args:
        i = args.index("--days")
        if i + 1 >= len(args):
            sys.exit("--days 后面要跟天数")
        days = max(1, int(args[i + 1]))
    per_day, stat = _scan_tokens(days=max(days, 90))
    picked = dict(sorted(per_day.items())[-days:])
    if "--json" in args:
        print(json.dumps({"days": picked, "scan": stat}, ensure_ascii=False))
        return
    if not picked:
        print("没有 token 记录(检查 ~/.codex/sessions)")
        return
    peak = max(v["total"] for v in picked.values()) or 1
    total = sum(v["total"] for v in picked.values())
    turns = sum(v["turns"] for v in picked.values())
    print(f"全池 token 消耗 · 近 {len(picked)} 天 · 合计 {total:,} · {turns} 轮 "
          f"(解析 {stat['scanned']} 文件, 缓存命中 {stat['reused']})")
    for d, v in picked.items():
        bar = "█" * max(1, round(v["total"] / peak * 42))
        print(f"  {d}  {v['total']:>12,}  {bar}")
    print(f"  日均 {total // max(1, len(picked)):,} · 单轮均 {total // max(1, turns):,}")


def cmd_current(args):
    s = _state()
    print(_mask(s.get("active")))


def cmd_health(args):
    """Token health: never rotates a token and costs no quota, but DOES record newly-found deaths.

    ★ By default this now ASKS THE SERVER (GET /models, unchallenged + free) instead of only reading the
    local JWT `exp`. A revoked token keeps a perfectly valid-looking exp — plus7 had 201h left while the
    server had already invalidated it — so an exp-only check reports a dead account as healthy (B21).
    `--local` keeps the old offline behaviour."""
    s = _state()
    if not s["slots"]:
        print("no accounts")
        return
    online = "--local" not in args
    now = time.time()
    for aid, slot in s["slots"].items():
        try:
            auth = _load_json(AUTH_DIR / slot["file"])
        except Exception:
            print(f"  [{slot.get('label', '?'):<8}] (no creds)")
            continue
        left = _access_exp(auth.get("tokens") or {}) - now
        st = f"access {left / 3600:.0f}h" if left > 0 else "access 已过期"
        if online and left > 0:
            alive = _token_alive(auth.get("tokens") or {})
            st += "  服务端:" + {True: "✅活", False: "☠️已作废", None: "?"}[alive]
            if alive is True:
                _revive_if_probe_marked(aid, slot)   # 否则同一行会打印「服务端:活」+「DEAD」自相矛盾
            if alive is False and not slot.get("auth_dead"):
                fp = ((auth.get("tokens") or {}).get("access_token") or "")[-16:] or None
                def _d(stt, a=aid, f=fp):
                    sl = stt.get("slots", {}).get(a)
                    if sl is not None:
                        sl["auth_dead"] = True
                        sl.setdefault("auth_dead_at", time.time())
                        sl["auth_dead_src"] = "probe"
                        if f:
                            sl["auth_dead_fp"] = f
                _mutate_state(_d)
                slot["auth_dead"] = True
            time.sleep(1.2)   # pacing
        who = slot.get("email") or _mask(aid)
        dead = "  ⚠️ DEAD 需 codex-rotate login 重登" if slot.get("auth_dead") else ""
        print(f"  [{slot.get('label', '?'):<8}] {who:<26} {st:<13} "
              f"last_refresh:{(auth.get('last_refresh') or '?')[:19]}{dead}")


def cmd_ensure(args):
    """Preflight: auto-capture the live account; if it's cooling, switch to a fresh one."""
    s = _state()
    _autosync_live(s)
    aid = s.get("active")
    if not aid or s["slots"].get(aid, {}).get("cooling_until", 0) <= time.time():
        return  # active is fine — silent no-op
    _syncback(s)
    target = _pick_next(s)
    if not target:
        _save_state(s)
        print("all accounts cooling — staying put")
        return
    with _cred_lock():
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    print(f"auto-switched (prev cooling) → [{s['slots'][target].get('label', '?')}]")


CMDS = {"add": cmd_add, "login": cmd_login, "list": cmd_list, "switch": cmd_switch, "cool": cmd_cool,
        "uncool": cmd_uncool, "quota": cmd_quota, "current": cmd_current, "ensure": cmd_ensure,
        "sync": cmd_sync, "rename": cmd_rename, "keepalive": cmd_keepalive, "refresh": cmd_refresh,
        "refresh-all": cmd_refresh_all, "health": cmd_health, "remove": cmd_remove,
        "ensure-live": cmd_ensure_live, "credits": cmd_credits, "probe": cmd_probe,
        "tokens": cmd_tokens}


# Commands that change what the menu bar shows → nudge SwiftBar to re-render immediately (so terminal
# commands update the menu instantly, not on its 10s tick). Excludes quota/sync/keepalive: the plugin
# runs `quota --save` every 10s, so refreshing there would loop; sync fires from the auth.json watcher.
REFRESH_AFTER = {"add", "login", "switch", "cool", "uncool", "rename", "refresh", "remove"}

# Disk-only commands run their whole load→mutate→save under the cross-process state mutex (lost-update
# guard). refresh/keepalive do network and write back via _mutate_state instead; health/current are
# read-only. Lock order is always state → cred, never the reverse (no deadlock).
STATE_LOCKED = {"add", "list", "switch", "cool", "uncool", "quota", "sync", "rename", "ensure", "remove"}


def _refresh_menu():
    """Best-effort, silent: ask the SwiftBar plugin to re-render now."""
    try:
        subprocess.run(["open", "-g", "swiftbar://refreshallplugins"], capture_output=True, timeout=3)
    except Exception:
        pass


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print("usage: codex-rotate {add <label>|login|remove <label>|list|switch [label]|cool [min]|uncool [label]|"
              "quota [--save]|sync|rename <old> <new>|refresh [label|all]|refresh-all|"
              "keepalive [days] [--dry-run]|health|credits [--force] [--json]|"
              "probe <label…|--all> [--model M] [--effort low|medium|high]|"
              "tokens [--days N] [--json]|ensure|current}")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd in STATE_LOCKED:
        with _state_mutex():
            CMDS[cmd](sys.argv[2:])
    else:
        CMDS[cmd](sys.argv[2:])
    if cmd in REFRESH_AFTER:
        _refresh_menu()


if __name__ == "__main__":
    main()
