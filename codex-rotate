#!/usr/bin/env python3
"""codex-account-rotator — swap ~/.codex/auth.json across multiple ChatGPT
subscription logins (one person, own accounts).

Slots are keyed by OAuth account_id. Every switch first syncs the live
auth.json back into its own slot (preserving any rotated refresh_token),
then loads the target slot. config.toml is shared and never touched.
Switch takes effect on the NEXT `codex` invocation, not mid-run.

Identity: the id_token (JWT) carries email / account_id / plan / subscription
expiry — decoded for human-friendly display.

Quota: Codex writes rate-limit telemetry (primary=5h, secondary=weekly) into
session rollouts. We read the newest rollout to show the ACTIVE account's live
usage, and snapshot it per-account on switch. Attribution guard: a rollout is
trusted for the active account only if produced after that account became
active (active_since), so one account's usage is never shown as another's.
"""
import base64
import contextlib
import datetime
import fcntl
import http.client
import json
import os
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

CODEX_HOME = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
LIVE = CODEX_HOME / "auth.json"
SESSIONS = CODEX_HOME / "sessions"
STORE = Path(__file__).resolve().parent
AUTH_DIR = STORE / "auth"
STATE = STORE / "state.json"
OAUTH_TOKEN_URL = "https://auth.openai.com/oauth/token"
OAUTH_CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"
REFRESH_LOCK = STORE / ".refresh.lock"   # cross-process: ALL credential movement (refresh + slot↔live copies)
STATE_LOCK = STORE / ".state.lock"       # cross-process state.json RMW mutex (shared with the proxy)
IDENT_FIELDS = ("email", "name", "plan", "sub_until")


def _load_json(p):
    with open(p) as f:
        return json.load(f)


def _account_id(auth):
    return (auth.get("tokens") or {}).get("account_id") or None


def _mask(aid):
    if not aid:
        return "?"
    return aid[:6] + "…" + aid[-4:] if len(aid) > 12 else aid


def _state():
    if STATE.exists():
        return _load_json(STATE)
    return {"slots": {}, "active": None, "active_since": 0}


def _save_state(s):
    _atomic_write(STATE, s, mode=0o600)


@contextlib.contextmanager
def _state_mutex():
    """Cross-process state.json mutex (the proxy's _mutate_state takes the same flock): held across a
    whole load→mutate→save so one writer can never clobber another's fields (cooling_until, auth_dead,
    quota, last_*). Commands that do network work must NOT hold this — use _mutate_state instead."""
    with open(STATE_LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        yield


def _mutate_state(fn):
    """flock'd read-modify-write for updates made AFTER slow work (an OAuth refresh): re-reads fresh
    state under the lock and applies a targeted mutation, instead of saving a stale in-memory copy."""
    with _state_mutex():
        s = _state()
        fn(s)
        _save_state(s)


@contextlib.contextmanager
def _cred_lock(nonblock=False):
    """Serializes ALL credential movement (OAuth refresh, slot↔live copies) across processes. A copy
    racing a refresh can write a consumed single-use refresh_token back over the fresh one = dead
    account. nonblock=True raises BlockingIOError instead of waiting (autosync: skip, retry next tick)."""
    with open(REFRESH_LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblock else 0))
        yield


def _atomic_write(path, data, mode=0o600):
    # UNIQUE temp name (mkstemp) — a fixed `*.tmp` is shared by the proxy + autosync + manual CLI, and
    # concurrent writers to the same temp path interleave bytes → corrupt JSON. Atomic os.replace then
    # gives, at worst, last-writer-wins (always a whole valid document, never garbage).
    d = path.parent
    fd, tmp = tempfile.mkstemp(dir=str(d), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _write_slot(aid, auth):
    AUTH_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(AUTH_DIR, 0o700)
    f = AUTH_DIR / f"{aid}.json"
    _atomic_write(f, auth)
    return f


def _read_live():
    if not LIVE.exists():
        sys.exit(f"no live auth at {LIVE}")
    return _load_json(LIVE)


def _activate(s, aid, since=None):
    s["active"] = aid
    s["active_since"] = time.time() if since is None else since


def _token_fp(auth):
    """Last 16 chars of the access token — enough to tell 'the very token the server rejected' from a
    genuinely new one (re-login / codex-native refresh). Used to gate auth_dead revival."""
    at = ((auth.get("tokens") or {}).get("access_token") or "")
    return at[-16:] or None


# ---------- identity (from id_token JWT) ----------

def _decode_identity(auth):
    tok = (auth.get("tokens") or {}).get("id_token")
    if not tok:
        return None
    try:
        seg = tok.split(".")[1]
        seg += "=" * (-len(seg) % 4)
        c = json.loads(base64.urlsafe_b64decode(seg))
    except Exception:
        return None
    oa = c.get("https://api.openai.com/auth") or {}
    return {
        "account_id": oa.get("chatgpt_account_id"),
        "email": c.get("email"),
        "name": c.get("name"),
        "plan": oa.get("chatgpt_plan_type"),
        "sub_until": oa.get("chatgpt_subscription_active_until"),
    }


def _stamp_identity(slot, auth, expect_aid=None):
    ident = _decode_identity(auth)
    if not ident or (expect_aid and ident.get("account_id") != expect_aid):
        return
    for k in IDENT_FIELDS:
        if ident.get(k):
            slot[k] = ident[k]


def _autosync_live(s):
    """Auto-capture / keep-fresh the currently-live account — no manual `add` needed.
    A freshly `codex login`-ed account gets a slot automatically (labelled main / plusN),
    its stored credentials are kept in sync (refresh_token rotation safety), and it is
    marked active. Idempotent: a no-op when the live account is already the active slot."""
    if not LIVE.exists():
        return
    try:
        # the copy LIVE→slot must be atomic wrt any in-flight refresh of the same slot file — a stale
        # LIVE write-back would resurrect a consumed refresh_token. Non-blocking: busy → next tick.
        with _cred_lock(nonblock=True):
            live = _load_json(LIVE)
            aid = _account_id(live)
            if not aid:
                return
            _write_slot(aid, live)  # keep stored creds current (so switch-back has a valid refresh_token)
    except (BlockingIOError, OSError, ValueError):
        return
    new = aid not in s["slots"]
    if new:
        existing = {sl.get("label") for sl in s["slots"].values()}
        n = len(s["slots"])
        label = "main" if n == 0 else f"plus{n + 1}"
        while label in existing:
            n += 1
            label = f"plus{n + 1}"
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    if new:
        slot["label"] = label
    _stamp_identity(slot, live, expect_aid=aid)
    lr_changed = False
    if live.get("last_refresh") and live["last_refresh"] != slot.get("last_refresh"):
        slot["last_refresh"] = live["last_refresh"]  # codex/native refresh of the active token bumped
        lr_changed = True                            # this — persist it so the menu's health stays fresh
    revived = False
    if slot.get("auth_dead") and _token_fp(live) != slot.get("auth_dead_fp"):
        # only a genuinely NEW token revives; re-seeing the very token the server rejected must NOT
        # clear the flag (otherwise the 10s quota--save tick puts a dead account straight back in pool)
        for k in ("auth_dead", "auth_dead_at", "auth_dead_fp"):
            slot.pop(k, None)
        revived = True
    changed = new or revived or lr_changed
    if s.get("active") != aid:
        _activate(s, aid)
        changed = True
    if changed:
        _save_state(s)


# ---------- quota (rate-limit telemetry from session rollouts) ----------

def _find_rl(o):
    """Locate the rate-limit object: a dict whose 'primary' is a dict with used_percent."""
    if isinstance(o, dict):
        p = o.get("primary")
        if isinstance(p, dict) and "used_percent" in p:
            return o
        for v in o.values():
            r = _find_rl(v)
            if r:
                return r
    elif isinstance(o, list):
        for v in o:
            r = _find_rl(v)
            if r:
                return r
    return None


def _newest_rollout():
    if not SESSIONS.is_dir():
        return None

    def newest_dir(d):
        subs = [c for c in d.iterdir() if c.is_dir()]
        return max(subs, key=lambda c: c.name) if subs else None

    y = newest_dir(SESSIONS)
    mo = newest_dir(y) if y else None
    if not mo:
        return None
    days = sorted((c for c in mo.iterdir() if c.is_dir()), key=lambda c: c.name, reverse=True)[:3]
    cand = []
    for dd in days:
        cand += list(dd.glob("rollout-*.jsonl"))
    if not cand:
        return None
    return max(cand, key=lambda p: p.stat().st_mtime)


def _rollout_is_proxy(p):
    """A rollout produced via cxp (session_meta.payload.model_provider == 'rotateproxy') records the
    PROXY-served account's telemetry, NOT the live/active account's — so it must never be attributed to
    `active` (that was the plus3≡plus5 cross-account leak). The proxy already accounts per-request."""
    try:
        with open(p) as fh:
            meta = json.loads(fh.readline())
        return ((meta.get("payload") or {}).get("model_provider")) == "rotateproxy"
    except Exception:
        return True  # can't tell → refuse attribution (fail-safe; never leak)


def _live_quota():
    """Read the newest rollout's last rate-limit event (bounded tail read)."""
    p = _newest_rollout()
    if not p or _rollout_is_proxy(p):
        return None
    try:
        sz = os.path.getsize(p)
        with open(p, "rb") as fh:
            if sz > 262144:
                fh.seek(sz - 262144)
            data = fh.read().decode("utf-8", "ignore")
    except OSError:
        return None
    rl = None
    for ln in data.splitlines():
        if '"used_percent"' not in ln:
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        f = _find_rl(d)
        if f:
            rl = f
    if not rl:
        return None
    return {
        "primary": rl.get("primary"),
        "secondary": rl.get("secondary"),
        "plan_type": rl.get("plan_type"),
        "captured_at": time.time(),
        "source_mtime": os.path.getmtime(p),
    }


def _attributable_quota(s):
    """Live quota only if a rollout was produced AFTER this account became active.
    Rollouts carry no account_id, so this time-window check is the only safe attribution —
    it prevents one account's usage from being shown as another's."""
    since = s.get("active_since", 0)
    if not since:
        return None  # unknown activation time → cannot safely attribute
    q = _live_quota()
    if q and q.get("source_mtime", 0) >= since:
        return q
    return None


def _access_exp(tok):
    try:
        seg = (tok.get("access_token") or "").split(".")[1]
        seg += "=" * (-len(seg) % 4)
        return json.loads(base64.urlsafe_b64decode(seg)).get("exp", 0)
    except Exception:
        return 0


def _refresh_slot(aid, slot, force=False, min_valid_seconds=3600):
    """Refresh one account's OAuth tokens, persisting the rotated bundle. SKIPS if the access token is
    still valid for more than `min_valid_seconds` (needless rotation is the #1 cause of accidental token
    death). Manual `refresh` keeps the conservative 1h; keepalive passes ~48h so a token expiring before
    the NEXT daily run is refreshed today (closes the idle-token coverage gap AND keeps last_refresh
    current so the menu's health signal stays honest). Serializes via a cross-process file lock +
    re-check so proxy/keepalive/manual never race the single-use refresh_token. Returns (ok, msg).
    Do NOT call on the ACTIVE account (codex owns its live token)."""
    sf = AUTH_DIR / slot["file"]
    try:
        auth = _load_json(sf)
    except (OSError, ValueError) as e:
        return False, f"read err: {e}"
    if not force and _access_exp(auth.get("tokens") or {}) - time.time() > min_valid_seconds:
        return True, "still valid"
    with _cred_lock():
        if _state().get("active") == aid:
            return True, "skip-active"  # switch raced us: now live → codex owns its token, never refresh
        auth = _load_json(sf)  # re-read under lock — another process may have just refreshed
        if not force and _access_exp(auth.get("tokens") or {}) - time.time() > min_valid_seconds:
            return True, "still valid"
        rt = (auth.get("tokens") or {}).get("refresh_token")
        if not rt:
            return False, "no refresh_token"
        body = json.dumps({"grant_type": "refresh_token", "client_id": OAUTH_CLIENT_ID,
                           "refresh_token": rt}).encode()
        req = urllib.request.Request(OAUTH_TOKEN_URL, data=body,
                                     headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                data = json.loads(r.read())
        except urllib.error.HTTPError as e:
            return False, f"http {e.code}"
        except Exception as e:
            return False, f"err: {e}"
        if not data.get("access_token"):
            return False, "no access_token in response"
        tok = auth.setdefault("tokens", {})
        tok["access_token"] = data["access_token"]
        if data.get("id_token"):
            tok["id_token"] = data["id_token"]
        if data.get("refresh_token"):
            tok["refresh_token"] = data["refresh_token"]  # rotation — persist the new one
        auth["last_refresh"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
        _atomic_write(sf, auth)
        slot["last_refresh"] = auth["last_refresh"]
        return True, "ok"


# ---------- slot mechanics ----------

def _syncback(s):
    """Persist current live auth into its own (account_id-keyed) slot."""
    if not LIVE.exists():
        return
    with _cred_lock():
        live = _load_json(LIVE)
        aid = _account_id(live)
        if not aid:
            return
        _write_slot(aid, live)
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    slot.setdefault("label", f"acct{len(s['slots'])}")
    _stamp_identity(slot, live, expect_aid=aid)
    if slot.get("auth_dead") and _token_fp(live) != slot.get("auth_dead_fp"):
        for k in ("auth_dead", "auth_dead_at", "auth_dead_fp"):  # new token only — see _autosync_live
            slot.pop(k, None)
    q = _attributable_quota(s)
    if q:
        slot["quota"] = q
    if s.get("active") != aid:
        _activate(s, aid)  # keep active_since in lockstep with active (attribution window correctness)


def _pick_next(s):
    now = time.time()
    aids = list(s["slots"].keys())
    active = s.get("active")
    order = aids
    if active in aids:
        i = aids.index(active)
        order = aids[i + 1:] + aids[:i + 1]
    for aid in order:
        if aid == active:
            continue
        if s["slots"][aid].get("cooling_until", 0) > now:
            continue
        if s["slots"][aid].get("auth_dead"):
            continue  # never hand the live auth to an account the server already rejected
        return aid
    return None


# ---------- commands ----------

def cmd_add(args):
    label = args[0] if args else None
    s = _state()
    with _cred_lock():
        live = _read_live()
        aid = _account_id(live)
        if not aid:
            sys.exit("live auth.json has no OAuth account_id (API-key login? run `codex login` first)")
        _write_slot(aid, live)
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    slot["label"] = label or slot.get("label") or f"acct{len(s['slots'])}"
    _stamp_identity(slot, live, expect_aid=aid)
    _activate(s, aid)  # since=now; quota fills in only once THIS account runs codex (no cross-account leak)
    _save_state(s)
    who = slot.get("email") or _mask(aid)
    print(f"added/updated [{slot['label']}] {who} (now active)")


def _qfmt(q):
    if not q:
        return ""
    p = (q.get("primary") or {}).get("used_percent")
    w = (q.get("secondary") or {}).get("used_percent")
    bits = []
    if p is not None:
        bits.append(f"5h:{p:.0f}%")
    if w is not None:
        bits.append(f"wk:{w:.0f}%")
    return "  " + " ".join(bits) if bits else ""


def cmd_list(args):
    s = _state()
    _autosync_live(s)
    now = time.time()
    active = s.get("active")
    if not s["slots"]:
        print("no slots yet — run: codex-rotate add <label>")
        return
    for aid, slot in s["slots"].items():
        flags = []
        if aid == active:
            flags.append("ACTIVE")
        cool = slot.get("cooling_until", 0)
        if cool > now:
            flags.append(f"cooling {int((cool - now) / 60)}m")
        who = slot.get("email") or _mask(aid)
        print(f"  [{slot.get('label', '?'):<8}] {who:<26} {' '.join(flags)}{_qfmt(slot.get('quota'))}")


def cmd_switch(args):
    s = _state()
    _syncback(s)
    if args:
        key = args[0]
        target = next((aid for aid, sl in s["slots"].items()
                       if aid == key or sl.get("label") == key), None)
        if not target:
            sys.exit(f"no slot matching '{key}'")
    else:
        target = _pick_next(s)
        if not target:
            sys.exit("no other available account (all cooling or only one slot)")
    with _cred_lock():
        # slot-read → LIVE-write → state-save as ONE credential move: the proxy's refresh path re-checks
        # `active` under this same flock, so it can never rotate a slot that just became live
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    who = s["slots"][target].get("email") or _mask(target)
    print(f"switched → [{s['slots'][target].get('label', '?')}] {who}  (effective on next `codex` run)")


def cmd_cool(args):
    mins = int(args[0]) if args else 300
    s = _state()
    aid = s.get("active")
    if not aid:
        sys.exit("no active slot")
    s["slots"].setdefault(aid, {})["cooling_until"] = time.time() + mins * 60
    _save_state(s)
    print(f"marked [{s['slots'][aid].get('label', '?')}] cooling {mins}m")


def cmd_uncool(args):
    """Clear cooldown (and the auth-dead flag) on a slot (label/account_id) or 'all' (default)."""
    target = args[0] if args else "all"
    s = _state()
    n = 0
    for aid, slot in s["slots"].items():
        if target in ("all", aid, slot.get("label")):
            cleared = slot.pop("cooling_until", None) is not None
            cleared |= slot.pop("auth_dead", None) is not None
            slot.pop("auth_dead_at", None)
            slot.pop("auth_dead_fp", None)
            if cleared:
                n += 1
    _save_state(s)
    print(f"cleared cooldown/dead on {n} slot(s)")


def cmd_sync(args):
    """Auto-capture the currently-live account into the pool (silent; used by the launchd watcher)."""
    _autosync_live(_state())


def cmd_rename(args):
    if len(args) < 2:
        sys.exit("usage: codex-rotate rename <old-label-or-id> <new-label>")
    old, new = args[0], args[1]
    s = _state()
    target = next((aid for aid, sl in s["slots"].items()
                   if aid == old or sl.get("label") == old), None)
    if not target:
        sys.exit(f"no slot matching '{old}'")
    s["slots"][target]["label"] = new
    _save_state(s)
    print(f"renamed → {new}")


def cmd_refresh(args):
    """Refresh one account (label/id) or 'all' via OAuth. Skips the ACTIVE account
    (codex owns its live token; refreshing it would rotate the token out from under codex)."""
    target = args[0] if args else "all"
    s = _state()
    active = s.get("active")
    out = []
    for aid, slot in s["slots"].items():
        if target not in ("all", aid, slot.get("label")):
            continue
        if aid == active:
            out.append(f"{slot.get('label')}:skip-active")
            continue
        ok, msg = _refresh_slot(aid, slot)
        if msg == "ok":  # persist last_refresh via a fresh RMW — a bulk save here would clobber
            _mutate_state(lambda st, a=aid, v=slot["last_refresh"]:  # concurrent proxy/plugin writes
                          st["slots"].setdefault(a, {}).update({"last_refresh": v}))
        out.append(f"{slot.get('label')}:{'ok' if ok else msg}")
    print("refresh " + (" ".join(out) if out else "(no matching slot)"))


def _slot_access_left_h(slot):
    """Hours until this slot's stored access token expires (None if unreadable)."""
    try:
        tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
    except (OSError, ValueError):
        return None
    return (_access_exp(tok) - time.time()) / 3600


def cmd_keepalive(args):
    """Keep idle accounts' tokens alive via OAuth refresh — cheap, no quota, no auth.json swap.
    Refreshes NON-active accounts whose access token expires within N hours (default 48 — wider than
    the 24h daily cadence, so a token is renewed the run BEFORE it would expire; this both closes the
    idle-token gap and keeps last_refresh current). The active account is skipped (codex owns its live
    token). `--dry-run` lists targets only. Was: last_refresh>4d — but B9 skip-if-valid froze
    last_refresh while tokens stayed healthy, so that gate never fired."""
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    thresh_h = float(pos[0]) if pos else 48.0
    s = _state()
    active = s.get("active")
    refreshed, skipped = [], []
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        if aid == active:
            skipped.append(f"{label}:active")
            continue
        left = _slot_access_left_h(slot)
        if dry:
            tgt = left is not None and left <= thresh_h
            (refreshed if tgt else skipped).append(f"{label}:{'?' if left is None else round(left)}h-left")
            continue
        ok, msg = _refresh_slot(aid, slot, min_valid_seconds=thresh_h * 3600)
        if msg == "ok":  # real refresh → persist last_refresh via targeted RMW (bulk save would clobber)
            _mutate_state(lambda st, a=aid, v=slot["last_refresh"]:
                          st["slots"].setdefault(a, {}).update({"last_refresh": v}))
            refreshed.append(f"{label}:ok")
        else:
            skipped.append(f"{label}:{msg}")  # 'still valid' / 'skip-active' are NO-OPS — not refreshes
    print(f"keepalive refreshed=[{', '.join(refreshed) or 'none'}] skipped=[{', '.join(skipped)}]")


def cmd_quota(args):
    """Print live quota of the active account; --save stamps quota + identity into the active slot."""
    s = _state()
    _autosync_live(s)
    p = _newest_rollout()
    # If the rotating proxy recently produced the newest rollout, it already accounted per-request;
    # attributing that rollout to the codex-rotate "active" account would mis-attribute. Skip then.
    proxy_owns = (p is not None and s.get("last_proxy_ts", 0) > 0
                  and p.stat().st_mtime <= s["last_proxy_ts"] + 12)
    q = None if proxy_owns else _attributable_quota(s)
    if "--save" in args and not proxy_owns:
        aid = s.get("active")
        if aid:
            slot = s["slots"].setdefault(aid, {})
            if q:
                slot["quota"] = q          # fresh reading attributable to this account (plain codex)
                slot["quota_status"] = "ok"
            elif slot.get("quota"):
                pass  # keep the last snapshot (proxy OR a prior plain-codex reading) — a stale snapshot
                      # beats '用量未知' when you switch back to an account; the leak is gated by Fix A
            else:
                since = s.get("active_since", 0)
                if p and since and p.stat().st_mtime >= since:
                    slot["quota_status"] = "empty"    # ran this stint but rollout had no rate_limit telemetry
                else:
                    slot["quota_status"] = "pending"  # never ran this account — no snapshot to show
            if LIVE.exists():
                _stamp_identity(slot, _load_json(LIVE), expect_aid=aid)
            if p and not _rollout_is_proxy(p):
                s["last_plain_ts"] = p.stat().st_mtime  # newest plain-codex activity — the title's
            _save_state(s)                              # cxp-vs-plain arbitration signal
    print(json.dumps(q, ensure_ascii=False) if q else "null")


PROBE_BODY = {
    "model": "gpt-5.5",
    "instructions": "Reply with exactly: ok",
    "input": [{"type": "message", "role": "user", "content": [{"type": "input_text", "text": "ok"}]}],
    "stream": True, "store": False,
}


def _probe_quota(aid, slot, is_active):
    """Send a minimal request from THIS account's own token and read the live x-codex-* quota headers.
    Read-only on the token (never OAuth-refreshes — the active account's live token stays codex-owned);
    active reads live auth.json, inactive reads its slot file. Returns (quota_dict|None, msg)."""
    authpath = LIVE if is_active else (AUTH_DIR / slot["file"])
    try:
        tok = (_load_json(authpath).get("tokens") or {})
    except (OSError, ValueError) as e:
        return None, f"read err: {e}"
    if _access_exp(tok) - time.time() < 60:
        return None, "token expired (\\codex login / wait keepalive)"
    body = json.dumps(PROBE_BODY).encode()
    conn = http.client.HTTPSConnection("chatgpt.com", 443, context=ssl.create_default_context(), timeout=60)
    try:
        conn.request("POST", "/backend-api/codex/responses", body=body, headers={
            "Authorization": f"Bearer {tok.get('access_token', '')}",
            "chatgpt-account-id": tok.get("account_id"),
            "Content-Type": "application/json", "originator": "codex_cli_rs",
            "Accept": "text/event-stream", "Content-Length": str(len(body))})
        r = conn.getresponse()
        h = {k.lower(): v for k, v in r.getheaders()}  # headers carry quota; SSE body not drained
        status = r.status
    except Exception as e:
        return None, f"req err: {e}"
    finally:
        conn.close()

    def num(key):
        try:
            return float(h[key])
        except (KeyError, ValueError, TypeError):
            return None

    pu, su = num("x-codex-primary-used-percent"), num("x-codex-secondary-used-percent")
    if pu is None and su is None:
        return None, f"HTTP {status} (no quota headers)"
    q = {
        "primary": {"used_percent": pu, "window_minutes": num("x-codex-primary-window-minutes"),
                    "resets_at": num("x-codex-primary-reset-at")},
        "secondary": {"used_percent": su, "window_minutes": num("x-codex-secondary-window-minutes"),
                      "resets_at": num("x-codex-secondary-reset-at")},
        "plan_type": h.get("x-codex-plan-type"), "captured_at": time.time(), "source": "probe",
    }
    return q, f"HTTP {status}"


def cmd_refresh_all(args):
    """Refresh EVERY account's quota snapshot to now — one minimal request per account from its own
    token (read-only: never refreshes a refresh_token, never switches the live account). Fixes the
    stale-snapshot problem: SwiftBar otherwise shows a non-active account's quota as of its last switch."""
    s = _state()
    active = s.get("active")
    out, notif, ok_n = [], [], 0
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        q, msg = _probe_quota(aid, slot, aid == active)
        if q:
            _mutate_state(lambda st, a=aid, qq=q: st["slots"].setdefault(a, {}).update(
                {"quota": qq, "quota_status": "ok"}))
            pr = 100 - (q["primary"]["used_percent"] or 0)
            wk = 100 - (q["secondary"]["used_percent"] or 0)
            out.append(f"{label}:5h{pr:.0f}%/wk{wk:.0f}%")
            notif.append(f"{label} 周{wk:.0f}%")
            ok_n += 1
        else:
            out.append(f"{label}:{msg}")
        time.sleep(0.4)  # gentle pacing
    _refresh_menu()
    if "--notify" in args:  # SwiftBar closes the dropdown on tap → a notification is the visible ACK
        total = len(s["slots"])
        body = "  ".join(notif) or "无可刷新账号"
        try:
            subprocess.run(["osascript", "-e",
                            f'display notification "{body}" with title "✅ 额度已刷新 {ok_n}/{total}"'],
                           capture_output=True, timeout=5)
        except Exception:
            pass
    print("refresh-all " + " ".join(out))


def cmd_current(args):
    s = _state()
    print(_mask(s.get("active")))


def cmd_health(args):
    """Read-only token health (no rotation): each account's access-token expiry + last_refresh."""
    s = _state()
    if not s["slots"]:
        print("no accounts")
        return
    now = time.time()
    for aid, slot in s["slots"].items():
        try:
            auth = _load_json(AUTH_DIR / slot["file"])
        except Exception:
            print(f"  [{slot.get('label', '?'):<8}] (no creds)")
            continue
        left = _access_exp(auth.get("tokens") or {}) - now
        st = f"access {left / 3600:.0f}h" if left > 0 else "access 已过期"
        who = slot.get("email") or _mask(aid)
        dead = "  ⚠️ DEAD 需 \\codex login 重登" if slot.get("auth_dead") else ""
        print(f"  [{slot.get('label', '?'):<8}] {who:<26} {st:<13} "
              f"last_refresh:{(auth.get('last_refresh') or '?')[:19]}{dead}")


def cmd_ensure(args):
    """Preflight: auto-capture the live account; if it's cooling, switch to a fresh one."""
    s = _state()
    _autosync_live(s)
    aid = s.get("active")
    if not aid or s["slots"].get(aid, {}).get("cooling_until", 0) <= time.time():
        return  # active is fine — silent no-op
    _syncback(s)
    target = _pick_next(s)
    if not target:
        _save_state(s)
        print("all accounts cooling — staying put")
        return
    with _cred_lock():
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    print(f"auto-switched (prev cooling) → [{s['slots'][target].get('label', '?')}]")


CMDS = {"add": cmd_add, "list": cmd_list, "switch": cmd_switch, "cool": cmd_cool,
        "uncool": cmd_uncool, "quota": cmd_quota, "current": cmd_current, "ensure": cmd_ensure,
        "sync": cmd_sync, "rename": cmd_rename, "keepalive": cmd_keepalive, "refresh": cmd_refresh,
        "refresh-all": cmd_refresh_all, "health": cmd_health}


# Commands that change what the menu bar shows → nudge SwiftBar to re-render immediately (so terminal
# commands update the menu instantly, not on its 10s tick). Excludes quota/sync/keepalive: the plugin
# runs `quota --save` every 10s, so refreshing there would loop; sync fires from the auth.json watcher.
REFRESH_AFTER = {"add", "switch", "cool", "uncool", "rename", "refresh"}

# Disk-only commands run their whole load→mutate→save under the cross-process state mutex (lost-update
# guard). refresh/keepalive do network and write back via _mutate_state instead; health/current are
# read-only. Lock order is always state → cred, never the reverse (no deadlock).
STATE_LOCKED = {"add", "list", "switch", "cool", "uncool", "quota", "sync", "rename", "ensure"}


def _refresh_menu():
    """Best-effort, silent: ask the SwiftBar plugin to re-render now."""
    try:
        subprocess.run(["open", "-g", "swiftbar://refreshallplugins"], capture_output=True, timeout=3)
    except Exception:
        pass


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print("usage: codex-rotate {add <label>|list|switch [label]|cool [min]|uncool [label]|"
              "quota [--save]|sync|rename <old> <new>|refresh [label|all]|refresh-all|"
              "keepalive [days] [--dry-run]|health|ensure|current}")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd in STATE_LOCKED:
        with _state_mutex():
            CMDS[cmd](sys.argv[2:])
    else:
        CMDS[cmd](sys.argv[2:])
    if cmd in REFRESH_AFTER:
        _refresh_menu()


if __name__ == "__main__":
    main()
