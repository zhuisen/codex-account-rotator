#!/usr/bin/env python3
"""codex-account-rotator — swap ~/.codex/auth.json across multiple ChatGPT
subscription logins (one person, own accounts).

Slots are keyed by OAuth account_id. Every switch first syncs the live
auth.json back into its own slot (preserving any rotated refresh_token),
then loads the target slot. config.toml is shared and never touched.
Switch takes effect on the NEXT `codex` invocation, not mid-run.

Identity: the id_token (JWT) carries email / account_id / plan / subscription
expiry — decoded for human-friendly display.

Quota: Codex writes rate-limit telemetry (primary=5h, secondary=weekly) into
session rollouts. We read the newest rollout to show the ACTIVE account's live
usage, and snapshot it per-account on switch. Attribution guard: a rollout is
trusted for the active account only if produced after that account became
active (active_since), so one account's usage is never shown as another's.
"""
import base64
import contextlib
import datetime
import fcntl
import http.client
import json
import os
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

CODEX_HOME = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
LIVE = CODEX_HOME / "auth.json"
SESSIONS = CODEX_HOME / "sessions"
STORE = Path(__file__).resolve().parent
AUTH_DIR = STORE / "auth"
STATE = STORE / "state.json"
OAUTH_TOKEN_URL = "https://auth.openai.com/oauth/token"
OAUTH_CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"
REFRESH_LOCK = STORE / ".refresh.lock"   # cross-process: ALL credential movement (refresh + slot↔live copies)
STATE_LOCK = STORE / ".state.lock"       # cross-process state.json RMW mutex (shared with the proxy)
IDENT_FIELDS = ("email", "name", "plan", "sub_until")


def _load_json(p):
    with open(p) as f:
        return json.load(f)


def _account_id(auth):
    return (auth.get("tokens") or {}).get("account_id") or None


def _mask(aid):
    if not aid:
        return "?"
    return aid[:6] + "…" + aid[-4:] if len(aid) > 12 else aid


def _state():
    if STATE.exists():
        return _load_json(STATE)
    return {"slots": {}, "active": None, "active_since": 0}


def _save_state(s):
    _atomic_write(STATE, s, mode=0o600)


@contextlib.contextmanager
def _state_mutex():
    """Cross-process state.json mutex (the proxy's _mutate_state takes the same flock): held across a
    whole load→mutate→save so one writer can never clobber another's fields (cooling_until, auth_dead,
    quota, last_*). Commands that do network work must NOT hold this — use _mutate_state instead."""
    with open(STATE_LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        yield


def _mutate_state(fn):
    """flock'd read-modify-write for updates made AFTER slow work (an OAuth refresh): re-reads fresh
    state under the lock and applies a targeted mutation, instead of saving a stale in-memory copy."""
    with _state_mutex():
        s = _state()
        fn(s)
        _save_state(s)


@contextlib.contextmanager
def _cred_lock(nonblock=False):
    """Serializes ALL credential movement (OAuth refresh, slot↔live copies) across processes. A copy
    racing a refresh can write a consumed single-use refresh_token back over the fresh one = dead
    account. nonblock=True raises BlockingIOError instead of waiting (autosync: skip, retry next tick)."""
    with open(REFRESH_LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblock else 0))
        yield


def _atomic_write(path, data, mode=0o600):
    # UNIQUE temp name (mkstemp) — a fixed `*.tmp` is shared by the proxy + autosync + manual CLI, and
    # concurrent writers to the same temp path interleave bytes → corrupt JSON. Atomic os.replace then
    # gives, at worst, last-writer-wins (always a whole valid document, never garbage).
    d = path.parent
    fd, tmp = tempfile.mkstemp(dir=str(d), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _write_slot(aid, auth):
    AUTH_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(AUTH_DIR, 0o700)
    f = AUTH_DIR / f"{aid}.json"
    _atomic_write(f, auth)
    return f


def _read_live():
    if not LIVE.exists():
        sys.exit(f"no live auth at {LIVE}")
    return _load_json(LIVE)


def _activate(s, aid, since=None):
    s["active"] = aid
    s["active_since"] = time.time() if since is None else since


def _token_fp(auth):
    """Last 16 chars of the access token — enough to tell 'the very token the server rejected' from a
    genuinely new one (re-login / codex-native refresh). Used to gate auth_dead revival."""
    at = ((auth.get("tokens") or {}).get("access_token") or "")
    return at[-16:] or None


# ---------- identity (from id_token JWT) ----------

def _decode_identity(auth):
    tok = (auth.get("tokens") or {}).get("id_token")
    if not tok:
        return None
    try:
        seg = tok.split(".")[1]
        seg += "=" * (-len(seg) % 4)
        c = json.loads(base64.urlsafe_b64decode(seg))
    except Exception:
        return None
    oa = c.get("https://api.openai.com/auth") or {}
    return {
        "account_id": oa.get("chatgpt_account_id"),
        "email": c.get("email"),
        "name": c.get("name"),
        "plan": oa.get("chatgpt_plan_type"),
        "sub_until": oa.get("chatgpt_subscription_active_until"),
    }


def _stamp_identity(slot, auth, expect_aid=None):
    ident = _decode_identity(auth)
    if not ident or (expect_aid and ident.get("account_id") != expect_aid):
        return
    for k in IDENT_FIELDS:
        if ident.get(k):
            slot[k] = ident[k]


def _autosync_live(s):
    """Auto-capture / keep-fresh the currently-live account — no manual `add` needed.
    A freshly `codex login`-ed account gets a slot automatically (labelled main / plusN),
    its stored credentials are kept in sync (refresh_token rotation safety), and it is
    marked active. Idempotent: a no-op when the live account is already the active slot."""
    if not LIVE.exists():
        return
    try:
        # the copy LIVE→slot must be atomic wrt any in-flight refresh of the same slot file — a stale
        # LIVE write-back would resurrect a consumed refresh_token. Non-blocking: busy → next tick.
        with _cred_lock(nonblock=True):
            live = _load_json(LIVE)
            aid = _account_id(live)
            if not aid:
                return
            _write_slot(aid, live)  # keep stored creds current (so switch-back has a valid refresh_token)
    except (BlockingIOError, OSError, ValueError):
        return
    new = aid not in s["slots"]
    if new:
        # ★ 按真实套餐命名,别再一律 plusN。plan 在 id_token 里,加号时本地就解得出(无需联网),
        # 所以没有理由先猜成 plus 再等人来纠。新增 Pro 号会得到 pro1/pro2…
        # 注意:label 只是昵称,**不是**判断套餐的依据 —— 老号从 Plus 升级到 Pro 时 label 不会变。
        # 要判套餐一律看 slot["plan"](UI 的 PRO 徽章也走它)。
        plan = ((_decode_identity(live) or {}).get("plan") or "plus").lower()
        prefix = "pro" if plan.startswith("pro") else "plus"
        existing = {sl.get("label") for sl in s["slots"].values()}
        n = len(s["slots"])
        label = "main" if n == 0 else f"{prefix}{n + 1}"
        while label in existing:
            n += 1
            label = f"{prefix}{n + 1}"
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    if new:
        slot["label"] = label
    _stamp_identity(slot, live, expect_aid=aid)
    lr_changed = False
    if live.get("last_refresh") and live["last_refresh"] != slot.get("last_refresh"):
        slot["last_refresh"] = live["last_refresh"]  # codex/native refresh of the active token bumped
        lr_changed = True                            # this — persist it so the menu's health stays fresh
    revived = False
    if slot.get("auth_dead") and _token_fp(live) != slot.get("auth_dead_fp"):
        # only a genuinely NEW token revives; re-seeing the very token the server rejected must NOT
        # clear the flag (otherwise the 10s quota--save tick puts a dead account straight back in pool)
        for k in ("auth_dead", "auth_dead_at", "auth_dead_fp"):
            slot.pop(k, None)
        revived = True
    changed = new or revived or lr_changed
    if s.get("active") != aid:
        _activate(s, aid)
        changed = True
    if changed:
        _save_state(s)


# ---------- quota (rate-limit telemetry from session rollouts) ----------

def _find_rl(o):
    """Locate the rate-limit object: a dict whose 'primary' is a dict with used_percent."""
    if isinstance(o, dict):
        p = o.get("primary")
        if isinstance(p, dict) and "used_percent" in p:
            return o
        for v in o.values():
            r = _find_rl(v)
            if r:
                return r
    elif isinstance(o, list):
        for v in o:
            r = _find_rl(v)
            if r:
                return r
    return None


def _newest_rollout():
    if not SESSIONS.is_dir():
        return None
    # Pick by MTIME (last append = freshest data), scanning the 2 newest MONTHS in full — NOT by the
    # newest-NAMED day directories. A long-running session RESUMED today keeps its ORIGINAL creation-date
    # filename + directory (e.g. sessions/2026/07/14/ appended at 07/22 09:38), so the old day-name window
    # ([:3] newest-named days) skipped it and quotad read a newer-NAMED but STALER file → displayed quota
    # lagged real usage (observed: live 50% vs stale rollout 20%). Attribution stays safe via source_mtime.
    months = []
    for y in SESSIONS.iterdir():
        if y.is_dir():
            for mo in y.iterdir():
                if mo.is_dir():
                    months.append((y.name, mo.name, mo))
    if not months:
        return None
    months.sort(key=lambda t: (t[0], t[1]), reverse=True)
    cand = []
    for _, _, mo in months[:2]:
        for dd in mo.iterdir():
            if dd.is_dir():
                cand += list(dd.glob("rollout-*.jsonl"))
    if not cand:
        return None
    return max(cand, key=lambda p: p.stat().st_mtime)


def _rollout_is_proxy(p):
    """A rollout produced via cxp (session_meta.payload.model_provider == 'rotateproxy') records the
    PROXY-served account's telemetry, NOT the live/active account's — so it must never be attributed to
    `active` (that was the plus3≡plus5 cross-account leak). The proxy already accounts per-request."""
    try:
        with open(p) as fh:
            meta = json.loads(fh.readline())
        return ((meta.get("payload") or {}).get("model_provider")) == "rotateproxy"
    except Exception:
        return True  # can't tell → refuse attribution (fail-safe; never leak)


def _live_quota():
    """Read the newest rollout's last rate-limit event (bounded tail read)."""
    p = _newest_rollout()
    if not p or _rollout_is_proxy(p):
        return None
    try:
        sz = os.path.getsize(p)
        with open(p, "rb") as fh:
            if sz > 262144:
                fh.seek(sz - 262144)
            data = fh.read().decode("utf-8", "ignore")
    except OSError:
        return None
    rl = None
    event_ts = None
    for ln in data.splitlines():
        if '"used_percent"' not in ln:
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        f = _find_rl(d)
        if f:
            rl = f
            # ★ The EVENT's own timestamp, not the file's. File mtime is only an upper bound: a session
            # appended after its last rate-limit event (resume, heartbeat, a response carrying no
            # telemetry) has mtime NEWER than the reading it holds. Comparing that mtime against a live
            # probe's captured_at would let stale telemetry win freshest-wins and revert a good reading.
            event_ts = _iso_ts(d.get("timestamp"))
    if not rl:
        return None
    mtime = os.path.getmtime(p)
    return {
        "primary": rl.get("primary"),
        "secondary": rl.get("secondary"),
        "plan_type": rl.get("plan_type"),
        "captured_at": time.time(),
        "source_mtime": mtime,          # attribution window (vs active_since) — unchanged semantics
        "event_ts": event_ts or mtime,  # when this reading was actually produced
    }


def _attributable_quota(s):
    """Live quota only if a rollout was produced AFTER this account became active.
    Rollouts carry no account_id, so this time-window check is the only safe attribution —
    it prevents one account's usage from being shown as another's."""
    since = s.get("active_since", 0)
    if not since:
        return None  # unknown activation time → cannot safely attribute
    q = _live_quota()
    if q and q.get("source_mtime", 0) >= since:
        return q
    return None


def _access_exp(tok):
    try:
        seg = (tok.get("access_token") or "").split(".")[1]
        seg += "=" * (-len(seg) % 4)
        return json.loads(base64.urlsafe_b64decode(seg)).get("exp", 0)
    except Exception:
        return 0


def _refresh_slot(aid, slot, force=False, min_valid_seconds=3600):
    """Refresh one account's OAuth tokens, persisting the rotated bundle. SKIPS if the access token is
    still valid for more than `min_valid_seconds` (needless rotation is the #1 cause of accidental token
    death). Manual `refresh` keeps the conservative 1h; keepalive passes ~48h so a token expiring before
    the NEXT daily run is refreshed today (closes the idle-token coverage gap AND keeps last_refresh
    current so the menu's health signal stays honest). Serializes via a cross-process file lock +
    re-check so proxy/keepalive/manual never race the single-use refresh_token. Returns (ok, msg).
    Do NOT call on the ACTIVE account (codex owns its live token)."""
    sf = AUTH_DIR / slot["file"]
    try:
        auth = _load_json(sf)
    except (OSError, ValueError) as e:
        return False, f"read err: {e}"
    if not force and _access_exp(auth.get("tokens") or {}) - time.time() > min_valid_seconds:
        return True, "still valid"
    with _cred_lock():
        if _state().get("active") == aid:
            return True, "skip-active"  # switch raced us: now live → codex owns its token, never refresh
        auth = _load_json(sf)  # re-read under lock — another process may have just refreshed
        if not force and _access_exp(auth.get("tokens") or {}) - time.time() > min_valid_seconds:
            return True, "still valid"
        rt = (auth.get("tokens") or {}).get("refresh_token")
        if not rt:
            return False, "no refresh_token"
        body = json.dumps({"grant_type": "refresh_token", "client_id": OAUTH_CLIENT_ID,
                           "refresh_token": rt}).encode()
        req = urllib.request.Request(OAUTH_TOKEN_URL, data=body,
                                     headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                data = json.loads(r.read())
        except urllib.error.HTTPError as e:
            return False, f"http {e.code}"
        except Exception as e:
            return False, f"err: {e}"
        if not data.get("access_token"):
            return False, "no access_token in response"
        tok = auth.setdefault("tokens", {})
        tok["access_token"] = data["access_token"]
        if data.get("id_token"):
            tok["id_token"] = data["id_token"]
        if data.get("refresh_token"):
            tok["refresh_token"] = data["refresh_token"]  # rotation — persist the new one
        auth["last_refresh"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
        _atomic_write(sf, auth)
        slot["last_refresh"] = auth["last_refresh"]
        return True, "ok"


# ---------- slot mechanics ----------

def _syncback(s):
    """Persist current live auth into its own (account_id-keyed) slot."""
    if not LIVE.exists():
        return
    with _cred_lock():
        live = _load_json(LIVE)
        aid = _account_id(live)
        if not aid:
            return
        _write_slot(aid, live)
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    slot.setdefault("label", f"acct{len(s['slots'])}")
    _stamp_identity(slot, live, expect_aid=aid)
    if slot.get("auth_dead") and _token_fp(live) != slot.get("auth_dead_fp"):
        for k in ("auth_dead", "auth_dead_at", "auth_dead_fp"):  # new token only — see _autosync_live
            slot.pop(k, None)
    # Freshest-wins, same rule as `quota --save`: a rollout is only a local echo of an earlier request,
    # so it must never overwrite a NEWER server-authoritative reading (usage-api / probe). Keeping the
    # guard only in cmd_quota left this path — plus switch/ensure, which also call _syncback — able to
    # roll a fresh reading back to a stale one. Fixed here so the whole class is covered in one place.
    q = _attributable_quota(s)
    if q and not _server_reading_is_fresher(slot.get("quota"), q):
        slot["quota"] = q
    if s.get("active") != aid:
        _activate(s, aid)  # keep active_since in lockstep with active (attribution window correctness)


def _pick_next(s):
    now = time.time()
    aids = list(s["slots"].keys())
    active = s.get("active")
    order = aids
    if active in aids:
        i = aids.index(active)
        order = aids[i + 1:] + aids[:i + 1]
    for aid in order:
        if aid == active:
            continue
        if s["slots"][aid].get("cooling_until", 0) > now:
            continue
        if s["slots"][aid].get("auth_dead"):
            continue  # never hand the live auth to an account the server already rejected
        return aid
    return None


# ---------- commands ----------

def cmd_add(args):
    label = args[0] if args else None
    s = _state()
    with _cred_lock():
        live = _read_live()
        aid = _account_id(live)
        if not aid:
            sys.exit("live auth.json has no OAuth account_id (API-key login? run `codex login` first)")
        _write_slot(aid, live)
    slot = s["slots"].setdefault(aid, {})
    slot["file"] = f"{aid}.json"
    slot["label"] = label or slot.get("label") or f"acct{len(s['slots'])}"
    _stamp_identity(slot, live, expect_aid=aid)
    _activate(s, aid)  # since=now; quota fills in only once THIS account runs codex (no cross-account leak)
    _save_state(s)
    who = slot.get("email") or _mask(aid)
    print(f"added/updated [{slot['label']}] {who} (now active)")


# Codex retired the 5h window (2026-07). Only weekly (10080) / monthly (43200) windows
# are real now; anything shorter is a deprecated/phantom slot (old 5h=300, empty=0) and
# must not be shown or counted.
REAL_WINDOW_MIN = 5000

# Quota snapshots read STRAIGHT FROM the server (authoritative, live) vs derived from a local rollout.
# "usage-api" = official GET /backend-api/codex/usage; "probe" = legacy x-codex-* header read.
SERVER_SOURCES = ("usage-api", "probe")


def _iso_ts(v):
    """'2026-07-29T02:11:36.830Z' -> unix seconds. None when unparseable."""
    if not isinstance(v, str):
        return None
    try:
        return datetime.datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _server_reading_is_fresher(existing, candidate):
    """True when the stored snapshot came STRAIGHT from the server and is newer than the rollout-derived
    candidate. Freshest-wins: a rollout is only a local echo of an earlier request, so it must never
    revert a newer authoritative reading (observed flicker: probe 58% -> quotad reverts to 80%).
    Compares the candidate's OWN event time (see _live_quota) rather than its file mtime."""
    existing = existing or {}
    if existing.get("source") not in SERVER_SOURCES:
        return False
    cand_ts = (candidate or {}).get("event_ts") or (candidate or {}).get("source_mtime") or 0
    return existing.get("captured_at", 0) > cand_ts

def _win_real(w):
    return bool(w) and (w.get("window_minutes") or 0) >= REAL_WINDOW_MIN

def _win_tag(w):
    return "月" if (w or {}).get("window_minutes", 0) >= 40000 else "周"

def _qfmt(q):
    """★ Prints USED percent — the opposite of what refresh-all and the GUI show (they show REMAINING).
    The bare `周:0%` was ambiguous enough to be misread as "no quota left" when it means "none used",
    so the label spells it out."""
    if not q:
        return ""
    bits = []
    for key in ("primary", "secondary"):
        w = q.get(key) or {}
        used = w.get("used_percent")
        if used is not None and _win_real(w):
            bits.append(f"{_win_tag(w)}已用:{used:.0f}%")
    return "  " + " ".join(bits) if bits else ""


def cmd_login(args):
    """Add / re-login an account with the smallest possible blast radius:  codex-rotate login

    ── What is actually known ──────────────────────────────────────────────────────────────────────
    OBSERVED (2026-07-30, two rounds): after logging in several accounts back to back, only the last
    one survived, and the accounts that died were the ones that had been sitting in ~/.codex/auth.json
    when the NEXT login ran. Confirmed revocations: plus4 and plus3 (401 from /models). plus6, never
    made live during either round, stayed alive.

        15:56:24 login plus4   ->  (previous live account revoked)
        15:56:57 login plus3   ->  plus4 revoked      <- plus4 was live
        15:58:09 login plus7   ->  plus3 revoked      <- plus3 was live

    NOT established: WHY. At least three mechanisms fit this data equally well —
      H1 the login flow revokes the token it finds in auth.json (an implicit logout);
      H2 the server revokes the previously issued grant for this device when a new one is issued;
      H3 signing out of chatgpt.com in the browser to switch accounts revokes the grant that session
         issued.
    Only 2 positive samples, and in this timeline "the account in auth.json" and "the previously
    logged-in account" are the same account every time, so they cannot be told apart. The binary
    string "failed to revoke auth tokens during logout" is about LOGOUT, and it reports a FAILED
    revoke — it is not evidence for H1. Treat the mechanism as unknown.

    ── What this command does about it ─────────────────────────────────────────────────────────────
    It takes auth.json OUT of the picture rather than betting on a hypothesis: syncback (so the live
    account's freshest token is preserved in its own slot), then MOVE auth.json aside, run
    `codex login` against an empty auth state, and adopt whatever comes back.

      • If H1 holds there is no token left for the login to revoke — the previous account survives.
      • If H2/H3 hold this is no worse than any other approach; nothing can prevent it client-side.
      • It never requires sacrificing a healthy account, so adding a brand-new account is always
        allowed, and on failure/Ctrl-C the saved file is put back (no dead account left live).

    This replaces an earlier "park a sacrificial account" design, which only helped under H1 and,
    worse, printed a reassuring message that would have been actively misleading under H2/H3."""
    with _state_mutex():
        s = _state()
        prev = s.get("active")
        prev_label = (s["slots"].get(prev) or {}).get("label", "?") if prev else None
        _syncback(s)      # the live account's freshest token is now safe in its own slot
        _save_state(s)

    # Move auth.json aside under the cred lock — the same lock every other credential move takes, so a
    # concurrent proxy/keepalive refresh can never observe a half-moved state.
    stash = LIVE.with_suffix(".rotator-stash")
    moved = False
    with _cred_lock():
        if LIVE.exists():
            os.replace(LIVE, stash)
            moved = True
    if prev_label:
        print(f"已把 [{prev_label}] 的 auth.json 移开并存回槽位 —— 登录期间本机没有可被作废的 token")
    print("launching `codex login`…")

    try:
        rc = subprocess.call(["codex", "login"])
    except KeyboardInterrupt:
        rc = 130
    if rc != 0 or not LIVE.exists():
        # Failed or aborted: put the previous credentials back, otherwise plain codex / omc / the proxy
        # are left with NO auth at all until the next daily keepalive.
        if moved:
            with _cred_lock():
                if not LIVE.exists():
                    os.replace(stash, LIVE)
                    moved = False
        print(f"登录未完成 (exit {rc}) —— 已恢复原来的 auth.json")
        sys.exit(1)
    if moved:
        with _cred_lock():
            try:
                stash.unlink()
            except OSError:
                pass
    with _state_mutex():
        s = _state()          # re-read under the lock (same B15 reasoning as above)
        _autosync_live(s)     # adopt the newly logged-in account into the pool
        _save_state(s)
        now_aid = s.get("active")
        lab = (s["slots"].get(now_aid) or {}).get("label", "?")
        who = (s["slots"].get(now_aid) or {}).get("email") or _mask(now_aid or "")

    # _autosync_live takes the cred lock NON-blocking and silently returns if it is busy (e.g. keepalive
    # is mid-OAuth). Don't claim an adoption that did not happen — confirm against the live account.
    try:
        live_aid = _account_id(_load_json(LIVE))
    except (OSError, ValueError):
        live_aid = None
    if live_aid and live_aid != now_aid:
        print("logged in, but the pool was busy — autosync will adopt it within a few seconds "
              "(check: codex-rotate list)")
    else:
        print(f"now active: [{lab}] {who}")
    print("验证全池:  codex-rotate health")


def cmd_remove(args):
    if not args:
        sys.exit("usage: codex-rotate remove <label>")
    key = args[0]
    s = _state()
    target = next((aid for aid, sl in s["slots"].items()
                   if aid == key or sl.get("label") == key), None)
    if not target:
        sys.exit(f"no slot matching '{key}'")
    slot = s["slots"].pop(target)
    if s.get("active") == target:
        remaining = list(s["slots"].keys())
        s["active"] = remaining[0] if remaining else None
        s["active_since"] = time.time() if remaining else 0
    _save_state(s)
    auth_file = AUTH_DIR / slot.get("file", "")
    if auth_file.exists():
        auth_file.unlink()
    who = slot.get("email") or slot.get("label") or _mask(target)
    print(f"removed [{slot.get('label', '?')}] {who}")


def cmd_list(args):
    s = _state()
    _autosync_live(s)
    now = time.time()
    active = s.get("active")
    if not s["slots"]:
        print("no slots yet — run: codex-rotate add <label>")
        return
    for aid, slot in s["slots"].items():
        flags = []
        if aid == active:
            flags.append("ACTIVE")
        cool = slot.get("cooling_until", 0)
        if cool > now:
            flags.append(f"cooling {int((cool - now) / 60)}m")
        who = slot.get("email") or _mask(aid)
        # A dead account's quota is a FROZEN snapshot from before it was revoked — printing it bare made
        # "周:0%" read as "quota exhausted" when the real problem was a revoked token (the exact question
        # this ambiguity provoked). Label the account and suppress the misleading number.
        if slot.get("auth_dead"):
            flags.append("✗DEAD")
            print(f"  [{slot.get('label', '?'):<8}] {who:<26} {' '.join(flags)}"
                  f"  额度未知(token 失效,codex-rotate login 重登)")
            continue
        print(f"  [{slot.get('label', '?'):<8}] {who:<26} {' '.join(flags)}{_qfmt(slot.get('quota'))}{_credit_fmt(slot)}")


def cmd_switch(args):
    s = _state()
    _syncback(s)
    if args:
        key = args[0]
        target = _resolve_slot(s, key)
        if not target:
            sys.exit(f"no slot matching '{key}'")
    else:
        target = _pick_next(s)
        if not target:
            sys.exit("no other available account (all cooling or only one slot)")
    with _cred_lock():
        # slot-read → LIVE-write → state-save as ONE credential move: the proxy's refresh path re-checks
        # `active` under this same flock, so it can never rotate a slot that just became live
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    who = s["slots"][target].get("email") or _mask(target)
    print(f"switched → [{s['slots'][target].get('label', '?')}] {who}  (effective on next `codex` run)")


def cmd_cool(args):
