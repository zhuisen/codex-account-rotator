def _slot_access_left_h(slot):
    """Hours until this slot's stored access token expires (None if unreadable)."""
    try:
        tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
    except (OSError, ValueError):
        return None
    return (_access_exp(tok) - time.time()) / 3600


def _codex_running():
    """True if a real `codex` CLI process is running — skip auth.json rotation then (codex owns its live
    token and may be mid-refresh). Conservative: also true during a cxp session (the proxy-routed codex
    binary), which is fine — rotation just waits for the next keepalive run. Ignores our own tooling."""
    try:
        out = subprocess.run(["pgrep", "-fl", "codex"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    for line in out.splitlines():
        low = line.lower()
        if ("codex-rotate" in low or "codex-account-rotator" in low
                or "codexbar" in low or "quota_daemon" in low):
            continue  # our own tooling, not a codex session
        # 只有**裸 codex** 会读/刷 ~/.codex/auth.json;cxp/代理会话(--profile rotateproxy)的 token 由代理
        # 的 auth-token 命令注入、不碰 auth.json → 放行(否则 graph-label 等 cxp 定时任务会一直阻塞轮换)。
        is_codex_bin = ("npm-global/bin/codex" in line or "codex-cli" in low
                        or "/.local/bin/codex" in line)
        if is_codex_bin and "rotateproxy" not in low:
            return True
    return False


def _ensure_live_healthy(s, *, force=False, quiet=False):
    """Keep ~/.codex/auth.json (the account plain `codex` + `omc ask codex` use) SERVER-ALIVE by rotating
    a fresh, server-healthy slot INTO it when the current live account is dead/near-expiry. 用户定稿
    2026-07-16(选项②).

    ★不变量:active 账号**永不被 rotator 原地 OAuth 刷新**(那会和 codex 原生刷新器抢一次性 refresh_token
    → B7/B8/B14 号死)。这里只做「换一个 keepalive 已保鲜的健康号进来」= 与 cmd_switch 同一套凭证移动。
    ★判死活直测 upstream(_probe_quota:200=活/401=服务端已 revoke),不能只看 JWT exp(B21:JWT 没过期
    但服务端已作废)。★codex 在跑时跳过(_codex_running),不覆盖活会话的 auth.json。返回状态串。"""
    if _codex_running():
        return "skip: codex running"
    active = s.get("active")
    active_slot = s["slots"].get(active) if active else None
    # 1) live 账号还服务端活 + JWT 不临近过期? >6h JWT 才值得探(<6h keepalive 该轮换了)。
    if active_slot and LIVE.exists() and not force:
        try:
            left = _access_exp((_load_json(LIVE).get("tokens") or {})) - time.time()
        except (OSError, ValueError):
            left = -1
        if left > 6 * 3600:
            q, _ = _probe_quota(active, active_slot, is_active=True)
            if q is not None:  # 200 + quota headers = 服务端活
                return "live healthy (no rotation)"
    # 2) live 死/临近过期 → 找最新鲜的**服务端健康**非活跃 slot,switch 进来。
    candidates = []
    for aid, slot in s["slots"].items():
        if aid == active or (slot.get("cooling_until") or 0) > time.time():
            continue
        try:
            tok = (_load_json(AUTH_DIR / slot["file"]).get("tokens") or {})
        except (OSError, ValueError, KeyError):
            continue
        jwt_left = _access_exp(tok) - time.time()
        if jwt_left < 6 * 3600:  # JWT 太近过期(keepalive 本该刷过)→ 跳,别换个也快死的进来
            continue
        q, _ = _probe_quota(aid, slot, is_active=False)  # 只读探,不刷新
        if q is None:  # 401/无 quota 头 = 服务端死
            continue
        candidates.append((jwt_left, aid, slot))
    if not candidates:
        return "no server-healthy slot to rotate in (\\codex login 补活号 / 等 keepalive 刷)"
    candidates.sort(key=lambda c: c[0], reverse=True)  # JWT 最新鲜优先
    _, target, tslot = candidates[0]
    # 3) 凭证移动 = cmd_switch 同款:syncback 现 live→其槽,再锁内 slot→LIVE→activate→save。
    _syncback(s)
    with _cred_lock():
        auth = _load_json(AUTH_DIR / s["slots"][target]["file"])
        _atomic_write(LIVE, auth)
        _activate(s, target)
        _save_state(s)
    who = tslot.get("label", _mask(target))
    if not quiet:
        print(f"[ensure-live] rotated auth.json → [{who}] (server-healthy; plain codex/omc 现在有活号)")
    return f"rotated → [{who}]"


def cmd_ensure_live(args):
    """选项②手动入口:检测 ~/.codex/auth.json 死/临近过期 → 轮换一个服务端健康号进来。`--force` 强制轮换。"""
    s = _state()
    _autosync_live(s)
    msg = _ensure_live_healthy(s, force="--force" in args)
    print(f"ensure-live: {msg}")


def cmd_keepalive(args):
    """Keep idle accounts' tokens alive via OAuth refresh — cheap, no quota, no auth.json swap.
    Refreshes NON-active accounts whose access token expires within N hours (default 48 — wider than
    the 24h daily cadence, so a token is renewed the run BEFORE it would expire; this both closes the
    idle-token gap and keeps last_refresh current). The active account is skipped (codex owns its live
    token). `--dry-run` lists targets only. Was: last_refresh>4d — but B9 skip-if-valid froze
    last_refresh while tokens stayed healthy, so that gate never fired."""
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    thresh_h = float(pos[0]) if pos else 48.0
    s = _state()
    active = s.get("active")
    refreshed, skipped = [], []
    for aid, slot in s["slots"].items():
        label = slot.get("label", _mask(aid))
        if aid == active:
            skipped.append(f"{label}:active")
            continue
        left = _slot_access_left_h(slot)
        if dry:
            tgt = left is not None and left <= thresh_h
            (refreshed if tgt else skipped).append(f"{label}:{'?' if left is None else round(left)}h-left")
            continue
        ok, msg = _refresh_slot(aid, slot, min_valid_seconds=thresh_h * 3600)
        if msg == "ok":  # real refresh → persist last_refresh via targeted RMW (bulk save would clobber)
            _mutate_state(lambda st, a=aid, v=slot["last_refresh"]:
                          st["slots"].setdefault(a, {}).update({"last_refresh": v}))
            refreshed.append(f"{label}:ok")
        else:
            skipped.append(f"{label}:{msg}")  # 'still valid' / 'skip-active' are NO-OPS — not refreshes
    print(f"keepalive refreshed=[{', '.join(refreshed) or 'none'}] skipped=[{', '.join(skipped)}]")
    # 选项②(2026-07-16):keepalive 尾部保活 ~/.codex/auth.json——非活跃号已刷新鲜,这里把最新鲜的
    # 服务端健康号轮进 auth.json,让裸 codex / omc ask codex 也一直有活号。重读 state 拿 _mutate_state
    # 刚落盘的 last_refresh,避免 _ensure_live_healthy 的 _save_state 回滚 keepalive 的更新。
    if not dry:
        print(f"ensure-live: {_ensure_live_healthy(_state())}")


def cmd_quota(args):
    """Print live quota of the active account; --save stamps quota + identity into the active slot."""
    s = _state()
    _autosync_live(s)
    p = _newest_rollout()
    # If the rotating proxy recently produced the newest rollout, it already accounted per-request;
    # attributing that rollout to the codex-rotate "active" account would mis-attribute. Skip then.
    proxy_owns = (p is not None and s.get("last_proxy_ts", 0) > 0
                  and p.stat().st_mtime <= s["last_proxy_ts"] + 12)
    q = None if proxy_owns else _attributable_quota(s)
    if "--save" in args and not proxy_owns:
        aid = s.get("active")
