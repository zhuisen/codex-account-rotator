# credentials & runtime state — NEVER commit (these hold OAuth tokens / account ids)
auth/
state.json
*.tmp
*.log
.keepalive.lock
.refresh.lock
.state.lock
state.json.corrupt-*
__pycache__/
scratch/
.omc/
.omx/

# Tauri / node build artifacts
codexbar/node_modules/
codexbar/dist/
codexbar/src-tauri/target/

# isolated test CODEX_HOME — keep only the config, drop codex runtime
proxy/test-home/*
!proxy/test-home/config.toml
.DS_Store

# native app build artifacts
app/**/*.app
app/**/.build
app/**/.build_number
.tokens-cache.json
.claude-tokens-cache.json
.traffic-cache.json
.traffic-latest.json
*.bak
# UI 验证 harness 的一次性夹具(含脱敏后的账号池快照,仍不入库)
codexbar/src/_*_probe.json
codexbar/harness.html
codexbar/src/harness-entry.tsx
# `codexbar/uishot/make_harness.py` 是工具,入库;`app/` 是它渲染用的 vite 产物(~1MB),不入库。
# 产物目录刻意不叫 dist:上面第 17 行已忽略 codexbar/dist/,而本机对 dist/ 还另有读取限制,
# 换个名字才能让静态服务器读到它。生成的 harness*.html 内含脱敏夹具,也一并挡掉。
codexbar/uishot/app/
traffic/sources.local.json
# agy 用量账本:运行期产物,含会话 id
traffic/agy-ledger/
# SLM 适配器落的本机工具产物,不属于本仓库
.agent/
.cursor/
