#!/usr/bin/env python3
"""agy wrapper —— 只为把 token 用量落盘，其余一概不干预。

★ 为什么需要它：agy 把用量**只**放在 `--output-format json` 的 stdout 里，本地零落盘
  （2026-08-18 实测：123 个会话的 SQLite + transcript.jsonl + cli.log，结构化 token 字段全 0）。
  云端也拿不到 —— `cloudcode-pa` 的 retrieveUserQuota 只回「剩余请求数」，不回 token。

★ 为什么放在 PATH 更前面而不是替换 `~/.local/bin/agy`：
  agy **自带自动更新**（`auto_check: true` / 24h；实测 2026-08-18 会话期间自己从 1.1.13 升到 1.1.14，
  直接改写 `~/.local/bin/agy`）。wrapper 放那儿会被静默抹掉，而"静默停止采集"正是最坏的失败形态。
  放在前面 + exec 真身，等于自动更新照常工作，wrapper 永远调到最新的二进制。

★ 失败一律 fail-open：任何解析/落盘异常都不能影响 agy 的输出与退出码。
  采集不到是小事，把用户的 agy 弄坏是大事。
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

REAL = Path(os.environ.get("AGY_REAL", str(Path.home() / ".local" / "bin" / "agy")))
LEDGER_DIR = Path(os.environ.get(
    "AGY_LEDGER_DIR",
    str(Path(__file__).resolve().parent.parent / "traffic" / "agy-ledger")))
# ★ 单文件,**不按月/按日分片**。用量是会话内累计值,解析器要按会话做差分;一旦分片,
#   跨片的会话在新片里的第一条会被当成新链起点,整段累计被记到那一天。单文件从构造上消除这个问题。
LEDGER = "usage.jsonl"

# `--prompt` 是 `--print` 的别名；`-i` / `--prompt-interactive` **不是**（它进交互态，没有 JSON 输出）。
PRINT_FLAGS = {"-p", "--print", "--prompt"}

AGY_LOG_DIR = Path(os.environ.get("AGY_LOG_DIR")
                   or (Path.home() / ".gemini" / "antigravity-cli" / "log"))
_MODEL_FLAG = re.compile(r'Print mode: starting \([^)]*model="([^"]*)"')
_MODEL_LABEL = re.compile(r'label="([^"]+)"')


def effective_model(conv, started):
    """本次运行**实际生效**的模型 -> 原始字符串,取不到返回 None。

    ★ 为什么不能只看 `--model`：`omc ask antigravity` 根本不传它（`runtime-cli.cjs` 只在
      `OMC_ANTIGRAVITY_DEFAULT_MODEL` 有值时才传），而 agy 的 JSON 输出、会话 SQLite、
      transcript 里**都没有模型名**。只剩日志这一处：
        printmode.go]  Print mode: starting (..., model="", ...)        ← 只回显命令行参数
        model_config_manager.go] Propagating selected model override to backend: label="Gemini 3.7 Flash (High)"
      后者才是真正生效的那个。**这台机器的默认是 3.7 Flash 不是 3.1 Pro**（2026-08-19 实测），
      两者单价差 2.7 倍 —— 猜错会让费用整体高估。

    ★ 按**会话 id** 定位日志文件，不是"取最新那份"：`omc team N:antigravity` 会并行起 N 个
      agy 进程、各写各的日志，按 mtime 取最新必然张冠李戴。
    ★ 同时用 `started` 卡住 mtime：`-c` 续接时旧日志里也有同一个 conv id。

    返回**原始字符串**（可能是 id 也可能是显示名），归一交给 `scan.py` 的 `_agy_model` ——
    两处各写一份归一规则，迟早在某个新型号上分叉。
    """
    try:
        if not AGY_LOG_DIR.is_dir():
            return None
        for f in sorted(AGY_LOG_DIR.glob("cli-*.log"),
                        key=lambda x: x.stat().st_mtime, reverse=True)[:12]:
            try:
                if f.stat().st_mtime < started - 2:
                    continue
                txt = f.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if conv not in txt:
                continue
            m = _MODEL_FLAG.search(txt)
            if m and m.group(1).strip():
                return m.group(1).strip()          # 调用方显式指定的，优先
            m = _MODEL_LABEL.search(txt)
            if m:
                return m.group(1).strip()          # agy 自己选的
            return None
    except Exception:
        return None                                # 采集不到模型名 ≠ 让这次调用失败
    return None


def passthrough(argv=None) -> None:
    """交给真身。用 execv 而不是 subprocess —— 交互态要保住 TTY、信号和退出码。

    ★★★ **必须传已经剥掉 `--as` 的 argv，不能用 `sys.argv[1:]`。**（2026-09-13 评审指出）
      `--as` 是**我们的** flag，agy 不认识它。而交互态正是走这条路的那一条，
      也就是说 `agy --as B` 这个最主要的用法，此前会把 `--as B` 原样递给真身。
    """
    os.execv(str(REAL), [str(REAL)] + list(sys.argv[1:] if argv is None else argv))


SAMPLER = Path(__file__).resolve().parent.parent / "traffic" / "agy_quota_sampler.py"


def start_quota_sampler() -> None:
    """拉起额度采样器(独立进程,自我终结)。★ 任何异常都必须被吞掉。

    ★★ **为什么必须在这里、而且必须是独立进程**:交互态走 `os.execv`,wrapper 进程
    会被真身**整个替换掉** —— 没有"之后"可言,也没有任何回调点。所以采样只能在
    拉起 agy **之前**交给一个不属于本进程生命周期的东西。

    ★★ **这条路径覆盖交互式会话,而 token 账本覆盖不了。** 用量只存在于 print 模式的
    stdout 里(近 90 天覆盖 15.9%),而额度是服务端真值,交互态照样会掉 ——
    所以采样器补的正是账本永远补不上的那 84%。两者单位不同、是两本账,别相加。

    ★ 不用 launchd 常驻:额度只在 agy 活着时才动,常驻一个 24×7 的进程去看一个
    大部分时间不动的数,既浪费又多一个要维护的服务。采样器自己会在没有 agy 时退出。
    ★ `start_new_session=True` + devnull 三件套:不继承 TTY、不往用户终端吐字、
    不随 wrapper/agy 的进程组一起被信号带走。

    ★★★ **必须双 fork —— 这里是本仓僵尸进程的真凶**(2026-09-17 四方评审抓出，实测坐实)。
      原来是一句裸 `subprocess.Popen(...)`，紧接着第 91 行 `os.execv` 换进程映像。
      **`execv` 换的是映像，不换父子关系**:采样器仍然挂在这个 pid 下，
      而接管这个 pid 的 agy 真身**根本不认识它**，永不 `waitpid`。
      于是采样器 180s 自退后 ⇒ **僵尸挂在常驻 agy 上，直到 agy 退出为止**。
      ⚠️ `start_new_session=True` 只让子进程 `setsid`，**不改 PPID、不转移 reap 责任** ——
        它防的是信号，不是僵尸。当时正是靠它误以为已经安全。
      实测(2026-09-17):本机 17 个 `<defunct>` 里 **7 个**父进程是 `~/.local/bin/agy`，
      每个常驻 agy 各挂 1 个；而同期 CodexBar 自己**一个都没有**。

      双 fork 之后孙进程被 **launchd(PID 1) 收养**，由内核 init 负责收尸，
      与 wrapper / agy 真身的生命周期彻底脱钩 —— 这正是"不属于本进程生命周期"那句话
      本来就想要的语义。中间那个 fork 出来的进程**立刻**被 `waitpid` 回收，不留痕迹。

    ⚠️ **绝不要改用 `signal.signal(SIGCHLD, SIG_IGN)`**:那个设置会**跨 `execv` 保留**，
      被 agy 真身继承后它自己的 `waitpid` 全部拿到 `ECHILD` ——
      用一个更贵、更难查的 bug 换掉这个。
    """
    try:
        if os.environ.get("AGY_SAMPLER_OFF") or not SAMPLER.exists():
            return
        pid = os.fork()
        if pid == 0:
            # ── 中间进程:setsid 脱离控制终端，再 fork 一次让孙进程被 init 收养 ──
            try:
                os.setsid()
                if os.fork() == 0:
                    devnull = os.open(os.devnull, os.O_RDWR)
                    for fd in (0, 1, 2):
                        os.dup2(devnull, fd)
                    os.execv(sys.executable, [sys.executable, str(SAMPLER)])
            except Exception:            # noqa: BLE001
                pass
            finally:
                os._exit(0)              # ★ 必须 `_exit`:普通 exit 会跑 atexit / flush
                                         #   父进程的缓冲区，在 fork 出来的副本里重复副作用。
        else:
            # ★ 立刻回收中间进程 —— 它只活几毫秒。不收的话**它自己**就成了那个僵尸，
            #   等于把问题从孙进程搬到儿子身上。
            os.waitpid(pid, 0)
    except Exception:                    # noqa: BLE001 — 采集不到是小事,弄坏 agy 是大事
        pass


def arg_value(argv: list, name: str):
    """取 `--name value` / `--name=value` 的值，取不到返回 None。"""
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def record(payload: dict, model, started: float) -> None:
    """把**累计**用量原样落一条。差分留给解析器算 —— 见下方口径说明。

    ★★ agy 的 usage 是**会话内累计**，不是本轮增量（2026-08-18 三轮实测：
       out 113 → 190 → 245 单调递增）。所以这里绝不能自作聪明地相减：
       wrapper 只看得见自己这一次调用，减不出正确的增量（`--conversation` 可以跳回任意旧会话）。
       差分必须在解析器里按 conv 分组、按 ts 排序后做。
    """
    u = payload.get("usage") or {}
    if not isinstance(u, dict) or not u:
        return
    conv0 = payload.get("conversation_id") or ""
    if not model and conv0:
        model = effective_model(conv0, started)
    rec = {
        "ts": round(time.time(), 3),
        "conv": payload.get("conversation_id") or "",
        "status": payload.get("status") or "",
        "model": model,
        # 累计值，原样存。字段名沿用 agy 自己的，避免多一层易错的改名。
        "input_tokens": int(u.get("input_tokens") or 0),
        "output_tokens": int(u.get("output_tokens") or 0),
        "thinking_tokens": int(u.get("thinking_tokens") or 0),
        "cache_read_tokens": int(u.get("cache_read_tokens") or 0),
        "total_tokens": int(u.get("total_tokens") or 0),
        "num_turns": payload.get("num_turns"),
        "dur": payload.get("duration_seconds"),
        "wrap": 1,
    }
    if not rec["conv"]:
        # 没有会话 id 就没法做差分，收下去只会污染。丢弃比记错好。
        return
    LEDGER_DIR.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(rec, ensure_ascii=False) + "\n").encode("utf-8")
    # ★ 一次 os.write 的 O_APPEND 追加。`omc team N:antigravity` 会并行起 N 个 pane
    #   同时写这一个文件;文本模式的 write 可能分多次系统调用,并发下会交错成半行。
    #   单次 write 且长度远小于 PIPE_BUF(4096) 时,POSIX 保证追加原子。
    fd = os.open(str(LEDGER_DIR / LEDGER), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


def select_account(argv):
    """启动前挑号并换凭证 -> 去掉 `--as` 之后的 argv。

    ★★★ **这是唯一能保证"本次会话用对号"的时刻。** agy 只在启动时读
      `antigravity-oauth-token`，之后不再读 —— 所以换号必须发生在 `execv` **之前**，
      而且对**已经开着**的 agy 会话无效。文案与行为都按这条来，别让用户以为点一下
      就把正在跑的那个切走了。

    两条路：
      · `agy --as <label>` / `AGY_ACCOUNT=<label>`  → 指定号（显式优先）
      · 其余                                        → `agy-rotate auto`：
        当前号剩余低于阈值才换，够用就不动（换号会打断 prompt 缓存）

    ★ **fail-open 只覆盖 `auto` 这一路**：轮换器不在、池是空的、网断了，
      让 agy 用当前登录态照常跑。轮换是增益不是前置条件。
    ★★★ **但 `--as` 不在 fail-open 范围里 —— 它是一条显式指令，做不到必须拒绝启动。**
      （2026-09-13 三方评审共同指出）原来 `check=False` + 裸 except 把失败全吞了，
      于是 `agy --as B` 会**安静地用 A 跑起来**：用户以为在花 B 的额度，实际花的是 A 的，
      而屏幕上没有任何异样。"采集失败不影响 CLI"那条策略不能套到账号选择上 ——
      前者丢的是一条统计，后者用错的是钱。
    """
    rot = Path(__file__).resolve().parent.parent / "agy-rotate"
    if not rot.exists():
        return argv
    want, out, i = os.environ.get("AGY_ACCOUNT"), [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--as" and i + 1 < len(argv):
            want, i = argv[i + 1], i + 2
            continue
        if a.startswith("--as="):
            want, i = a[5:], i + 1
            continue
        out.append(a)
        i += 1
    if not want:
        try:
            subprocess.run([sys.executable, str(rot), "auto"], timeout=60, check=False)
        except Exception:                               # noqa: BLE001
            pass
        return out
    # ★★★ 显式指定号：失败一律**拒绝启动**，别拿另一个号的额度替他跑。
    try:
        # ★ `--for-this-run`：`--as` 是**一次性**指定，不该变成长期偏好 ——
        #   否则之后每次裸跑 `agy` 都会被 `auto` 拉回这个号。
        r = subprocess.run([sys.executable, str(rot), "switch", want, "--for-this-run"],
                           timeout=60, check=False)
        rc = r.returncode
    except Exception as e:                              # noqa: BLE001
        sys.stderr.write("agy-wrap: 切到 [%s] 失败：%s —— 已中止（不替你用别的号跑）\n"
                         % (want, e))
        raise SystemExit(3)
    if rc != 0:
        sys.stderr.write("agy-wrap: 切到 [%s] 失败（exit %d）—— 已中止。\n"
                         "  去掉 `--as` 可以用当前登录的号跑。\n" % (want, rc))
        raise SystemExit(3)
    return out


def main() -> None:
    argv = sys.argv[1:]
    if not REAL.exists():
        sys.stderr.write(f"agy-wrap: 真身不存在: {REAL}\n")
        sys.exit(127)

    # ★ 必须在分支**之前** —— 交互态那条走 execv,过了那行就没有本进程了。
    start_quota_sampler()
    argv = select_account(argv)

    is_print = any(a in PRINT_FLAGS or a.startswith("--print=") or a.startswith("--prompt=")
                   for a in argv)
    fmt = arg_value(argv, "--output-format")

    # 三种处置，界线是「会不会改变调用方看到的东西」：
    #   交互态 / stream-json  → execv 放行。接管流式会把它变成缓冲，那是可见的行为改变。
    #   print + json          → 截获、记账、把原始 JSON 原样回吐（一次性输出，零差异）。
    #   print + text/缺省      → 截获、记账、把 response 还原成文本（调用方看到的与原来一致）。
    if not is_print or fmt == "stream-json":
        passthrough(argv)          # ★ 剥过 `--as` 的那份，见 `passthrough` 的说明
    emit_raw = fmt == "json"

    run_argv, i = [str(REAL)], 0
    while i < len(argv):
        a = argv[i]
        if a == "--output-format":          # 换掉它的值
            run_argv += ["--output-format", "json"]; i += 2; continue
        if a.startswith("--output-format="):
            run_argv.append("--output-format=json"); i += 1; continue
        run_argv.append(a); i += 1
    if fmt is None:
        run_argv += ["--output-format", "json"]

    # stderr 直通（进度、报错要实时可见）；只截 stdout。
    started = time.time()
    p = subprocess.run(run_argv, stdout=subprocess.PIPE)
    out = p.stdout.decode("utf-8", errors="replace")

    try:
        payload = json.loads(out)
    except Exception:
        # 解析不了就原样吐出去 —— 绝不因为采集失败而吞掉 agy 的输出。
        sys.stdout.write(out)
        sys.exit(p.returncode)

    try:
        record(payload, arg_value(argv, "--model"), started)
    except Exception as e:
        sys.stderr.write(f"agy-wrap: 用量落盘失败（不影响本次调用）: {type(e).__name__}: {e}\n")

    # 还原成调用方期待的形态。`response` 自带结尾换行，不要再补。
    sys.stdout.write(out if emit_raw else (payload.get("response") or ""))
    if payload.get("status") != "SUCCESS" and payload.get("error"):
        sys.stderr.write(str(payload["error"]) + "\n")
    sys.exit(p.returncode)


if __name__ == "__main__":
    main()
