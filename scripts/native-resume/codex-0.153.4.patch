+//! CodexBar's local compatibility boundary; storage and execution providers stay distinct.
+
+use codex_protocol::ThreadId;
+use sha2::Digest;
+use sha2::Sha256;
+use std::fs;
+use std::io;
+use std::path::Path;
+
+pub(crate) fn provider_filter(default_provider: String) -> Vec<String> {
+    if default_provider == "rotateproxy" {
+        vec![default_provider, "openai".to_string()]
+    } else {
+        vec![default_provider]
+    }
+}
+
+pub(crate) fn mark_proxy_resume(
+    store: &Path,
+    codex_home: &Path,
+    thread_id: ThreadId,
+) -> io::Result<()> {
+    let home = fs::canonicalize(codex_home)?;
+    let home = home.to_string_lossy().into_owned();
+    #[cfg(windows)]
+    let home = if let Some(unc) = home.strip_prefix(r"\\?\UNC\") {
+        format!(r"\\{unc}").to_lowercase()
+    } else {
+        home.strip_prefix(r"\\?\").unwrap_or(&home).to_lowercase()
+    };
+    let key = format!("{:x}", Sha256::digest(home.as_bytes()));
+    let directory = store.join(".proxy-sessions-v1").join(key);
+    let mut builder = fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    builder.create(&directory)?;
+    let path = directory.join(thread_id.to_string());
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    match options.open(&path) {
+        Ok(file) => file.sync_all(),
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+            if fs::symlink_metadata(&path)?.file_type().is_file() {
+                Ok(())
+            } else {
+                Err(io::Error::other("Invalid CodexBar proxy session marker"))
+            }
+        }
+        Err(error) => Err(error),
+    }
+}
