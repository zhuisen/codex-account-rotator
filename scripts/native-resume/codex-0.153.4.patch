+use super::*;
+
+#[test]
+fn compatible_history_is_limited_to_the_rotation_provider() {
+    assert_eq!(
+        provider_filter("rotateproxy".into()),
+        ["rotateproxy", "openai"]
+    );
+    assert_eq!(provider_filter("openai".into()), ["openai"]);
+    assert_eq!(provider_filter("unrelated".into()), ["unrelated"]);
+}
+
+#[test]
+fn marker_is_idempotent_and_home_scoped() -> io::Result<()> {
+    let fixture = tempfile::tempdir()?;
+    let home = fixture.path().join("中文 home");
+    fs::create_dir(&home)?;
+    let store = fixture.path().join("store");
+    let id = ThreadId::new();
+    mark_proxy_resume(&store, &home, id)?;
+    mark_proxy_resume(&store, &home, id)?;
+    assert_eq!(fs::read_dir(store.join(".proxy-sessions-v1"))?.count(), 1);
+    let other = fixture.path().join("other");
+    fs::create_dir(&other)?;
+    mark_proxy_resume(&store, &other, id)?;
+    assert_eq!(fs::read_dir(store.join(".proxy-sessions-v1"))?.count(), 2);
+    Ok(())
+}
+
+#[test]
+fn corrupt_store_is_an_error_before_resume() -> io::Result<()> {
+    let fixture = tempfile::tempdir()?;
+    fs::write(fixture.path().join(".proxy-sessions-v1"), b"damaged")?;
+    assert!(mark_proxy_resume(fixture.path(), fixture.path(), ThreadId::new()).is_err());
+    Ok(())
+}
